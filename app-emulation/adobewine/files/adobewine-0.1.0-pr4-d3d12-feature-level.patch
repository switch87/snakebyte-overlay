diff --git a/scripts/setup-prefix.sh b/scripts/setup-prefix.sh
index 0a502ac..0e638c4 100755
--- a/scripts/setup-prefix.sh
+++ b/scripts/setup-prefix.sh
@@ -62,6 +62,25 @@ elif command -v x86_64-w64-mingw32-gcc >/dev/null; then
 else
   echo "note: no MinGW compiler, skipping the d3d12 shim (Adobe AI features may be unavailable)" >&2
 fi
+# Photoshop's GPU check (sniffer.exe) wants a Direct3D 12 device at feature level 12_0 and
+# reports no GPU at all without one. vkd3d-proton offers 12_0 only with Vulkan sparse
+# residency, which some drivers lack although the Windows driver for the same GPU offers 12_x
+# (e.g. Mesa on Gen9 Intel graphics). Such GPUs get VKD3D_FEATURE_LEVEL=12_0 in the prefix's
+# environment; others get nothing, as the override would cap them at 12_0.
+ENVKEY='HKCU\Environment'
+wine reg delete "$ENVKEY" /v VKD3D_FEATURE_LEVEL /f >/dev/null 2>&1 || true
+FL="$ADOBEWINE_SRC/lib/d3d12fl.exe"
+[ -f "$FL" ] || FL="$ADOBEWINE_HOME/d3d12fl.exe"
+if [ ! -f "$FL" ] && command -v x86_64-w64-mingw32-gcc >/dev/null; then
+  x86_64-w64-mingw32-gcc -O2 -o "$FL" "$ADOBEWINE_SRC/tools/d3d12fl/d3d12fl.c"
+fi
+if [ -f "$FL" ]; then
+  level="$(env -u VKD3D_FEATURE_LEVEL wine "$FL" 2>/dev/null | tr -d '\r')" && rc=0 || rc=$?
+  if [ "$rc" = 2 ]; then
+    wine reg add "$ENVKEY" /v VKD3D_FEATURE_LEVEL /d 12_0 /f >/dev/null
+    echo "note: this GPU offers Direct3D 12 feature level $level only; reporting 12_0 so Photoshop uses it." >&2
+  fi
+fi
 # NVIDIA only: CUDA / NVENC / NVAPI / NVML bridges to the Linux driver.
 if [ -e /proc/driver/nvidia/version ]; then
   "$(ls -d "$DEPS"/nvidia-libs-*/ | head -1)/setup_nvlibs.sh" install
diff --git a/tools/d3d12fl/d3d12fl.c b/tools/d3d12fl/d3d12fl.c
new file mode 100644
index 0000000..814c96b
--- /dev/null
+++ b/tools/d3d12fl/d3d12fl.c
@@ -0,0 +1,40 @@
+/* Prints the highest Direct3D 12 feature level the default adapter can create a device at.
+ * Photoshop's GPU check (sniffer.exe) creates its device at D3D_FEATURE_LEVEL_12_0 and
+ * reports no GPU at all when that fails. vkd3d-proton offers 12_0 only when the Vulkan
+ * driver has sparse residency (tiled resources tier 2), which some drivers lack although
+ * the Windows driver for the same GPU offers 12_x (e.g. Mesa ANV on Gen9 Intel graphics).
+ * Exit code: 0 = 12_0 or higher, 2 = 11_x only, 1 = no Direct3D 12 device. */
+#define COBJMACROS
+#define INITGUID
+#include <windows.h>
+#include <stdio.h>
+#include <d3d12.h>
+
+int main(void)
+{
+    static const struct { D3D_FEATURE_LEVEL level; const char *name; } levels[] =
+    {
+        {D3D_FEATURE_LEVEL_12_2, "12_2"}, {D3D_FEATURE_LEVEL_12_1, "12_1"},
+        {D3D_FEATURE_LEVEL_12_0, "12_0"}, {D3D_FEATURE_LEVEL_11_1, "11_1"},
+        {D3D_FEATURE_LEVEL_11_0, "11_0"},
+    };
+    HRESULT (WINAPI *create)(IUnknown *, D3D_FEATURE_LEVEL, REFIID, void **);
+    HMODULE d3d12 = LoadLibraryA("d3d12.dll");
+    ID3D12Device *device;
+    unsigned int i;
+
+    if (!d3d12 || !(create = (void *)GetProcAddress(d3d12, "D3D12CreateDevice")))
+    {
+        printf("none\n");
+        return 1;
+    }
+    for (i = 0; i < ARRAYSIZE(levels); i++)
+    {
+        if (FAILED(create(NULL, levels[i].level, &IID_ID3D12Device, (void **)&device))) continue;
+        ID3D12Device_Release(device);
+        printf("%s\n", levels[i].name);
+        return levels[i].level >= D3D_FEATURE_LEVEL_12_0 ? 0 : 2;
+    }
+    printf("none\n");
+    return 1;
+}
