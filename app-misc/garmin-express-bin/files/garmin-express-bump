#!/bin/bash
# Bump app-misc/garmin-express-bin to the version currently served by Garmin.
# Usage: sudo bash files/garmin-express-bump   (then: emerge -1 garmin-express-bin)
set -euo pipefail
cd "$(dirname "$0")/.."
DISTDIR=$(portageq envvar DISTDIR)
tmp=$(mktemp)
trap 'rm -f "${tmp}"' EXIT
curl -fsSL -o "${tmp}" https://download.garmin.com/omt/express/GarminExpress.exe
ver=$(exiftool -s3 -ProductVersion "${tmp}")
[[ ${ver} =~ ^[0-9.]+$ ]] || { echo "unknown version: ${ver}" >&2; exit 1; }
old=$(ls garmin-express-bin-*.ebuild | head -n1)
new="garmin-express-bin-${ver}.ebuild"
if [[ ${old} == "${new}" ]]; then echo "already at ${ver}"; exit 0; fi
install -m644 "${tmp}" "${DISTDIR}/garmin-express-bin-${ver}.exe"
git mv "${old}" "${new}" 2>/dev/null || mv "${old}" "${new}"
ebuild "${new}" manifest
echo "bumped to ${ver}"
