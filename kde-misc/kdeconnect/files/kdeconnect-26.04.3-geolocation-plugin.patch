diff --git a/plugins/geolocation/kdeconnect_geolocation_config.qml b/plugins/geolocation/kdeconnect_geolocation_config.qml
new file mode 100644
index 000000000..8dd1eb5a4
--- /dev/null
+++ b/plugins/geolocation/kdeconnect_geolocation_config.qml
@@ -0,0 +1,80 @@
+/**
+ * SPDX-FileCopyrightText: 2026 Gert Pellin <gert@pellin.be>
+ *
+ * SPDX-License-Identifier: GPL-2.0-only OR GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
+ */
+
+import QtQuick 2.15
+import QtQuick.Controls 2.15 as QQC2
+import QtQuick.Layouts 1.15
+import org.kde.kirigami 2.20 as Kirigami
+import org.kde.kdeconnect 1.0
+
+Kirigami.ScrollablePage {
+    id: root
+
+    property string device
+
+    Component.onCompleted: {
+        nmeaEnabled.checked = config.getBool("nmeaEnabled", false)
+        nmeaPort.value = config.getInt("nmeaPort", 10110)
+    }
+
+    Kirigami.FormLayout {
+        KdeConnectPluginConfig {
+            id: config
+            deviceId: device
+            pluginName: "kdeconnect_geolocation"
+        }
+
+        QQC2.CheckBox {
+            id: nmeaEnabled
+            text: i18nd("kdeconnect-plugins", "Offer this device's location to applications (NMEA over TCP)")
+            focus: true
+            onClicked: config.set("nmeaEnabled", checked)
+        }
+
+        QQC2.SpinBox {
+            id: nmeaPort
+            Kirigami.FormData.label: i18nd("kdeconnect-plugins", "Port on localhost:")
+            from: 1
+            to: 65535
+            editable: true
+            enabled: nmeaEnabled.checked
+            // A port number, not a quantity: no digit grouping ("10110", not "10,110").
+            textFromValue: function(value, locale) { return value.toString() }
+            valueFromText: function(text, locale) {
+                const port = parseInt(text, 10)
+                return isNaN(port) ? value : port
+            }
+            validator: IntValidator {
+                bottom: nmeaPort.from
+                top: nmeaPort.to
+            }
+            // Every change makes the daemon listen again: wait until the user
+            // stops stepping through the numbers, or leaves the field.
+            onValueModified: commitPort.restart()
+            onActiveFocusChanged: if (!activeFocus && commitPort.running) {
+                commitPort.stop()
+                config.set("nmeaPort", value)
+            }
+            // The page may close before the timer fires.
+            Component.onDestruction: if (commitPort.running) {
+                commitPort.stop()
+                config.set("nmeaPort", value)
+            }
+
+            Timer {
+                id: commitPort
+                interval: 1000
+                onTriggered: config.set("nmeaPort", nmeaPort.value)
+            }
+        }
+
+        QQC2.Label {
+            Layout.fillWidth: true
+            wrapMode: Text.WordWrap
+            text: i18nd("kdeconnect-plugins", "Every program and every user on this computer can read the location from this port. The device only sends its location while a program is connected. Each device needs its own port.")
+        }
+    }
+}
diff --git a/plugins/geolocation/nmea.cpp b/plugins/geolocation/nmea.cpp
new file mode 100644
index 000000000..692c2f853
--- /dev/null
+++ b/plugins/geolocation/nmea.cpp
@@ -0,0 +1,127 @@
+/**
+ * SPDX-FileCopyrightText: 2026 Gert Pellin <gert@pellin.be>
+ *
+ * SPDX-License-Identifier: GPL-2.0-only OR GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
+ */
+
+#include "nmea.h"
+
+#include <QStringList>
+#include <QTimeZone>
+
+#include <algorithm>
+#include <cmath>
+
+bool Nmea::hasValidChecksum(const QString &sentence)
+{
+    const qsizetype star = sentence.size() - 3;
+    if (star < 1 || sentence.size() > MaxSentenceLength || !sentence.startsWith(QLatin1Char('$')) || sentence.at(star) != QLatin1Char('*')) {
+        return false;
+    }
+    // Checked explicitly: toUInt() would also take a sign or blanks.
+    const QString hexDigits = QStringLiteral("0123456789ABCDEFabcdef");
+    if (!hexDigits.contains(sentence.at(star + 1)) || !hexDigits.contains(sentence.at(star + 2))) {
+        return false;
+    }
+    uint sum = 0;
+    for (qsizetype i = 1; i < star; ++i) {
+        const char16_t c = sentence.at(i).unicode();
+        if (c < 0x20 || c > 0x7E) { // printable ASCII only: no line breaks, nothing toLatin1() would mangle
+            return false;
+        }
+        sum ^= c;
+    }
+    return sum == QStringView(sentence).sliced(star + 1).toUInt(nullptr, 16);
+}
+
+namespace
+{
+bool isDigits(QStringView value)
+{
+    return std::all_of(value.begin(), value.end(), [](QChar c) {
+        return c >= u'0' && c <= u'9';
+    });
+}
+
+// "ddmm.mmmm" / "dddmm.mmmm" plus hemisphere -> signed decimal degrees.
+bool parseCoordinate(const QString &value, const QString &hemisphere, QLatin1StringView positive, QLatin1StringView negative, double limit, double &result)
+{
+    // Digits and at most one '.': no sign, exponent, nan or inf.
+    const qsizetype dot = value.indexOf(QLatin1Char('.'));
+    const QStringView whole = QStringView(value).first(dot < 0 ? value.size() : dot);
+    if (whole.isEmpty() || !isDigits(whole) || (dot >= 0 && !isDigits(QStringView(value).sliced(dot + 1)))) {
+        return false;
+    }
+    const double raw = value.toDouble();
+    const double degrees = std::floor(raw / 100.0);
+    const double minutes = raw - degrees * 100.0;
+    double decimal = degrees + minutes / 60.0;
+    if (minutes >= 60.0 || decimal > limit) {
+        return false;
+    }
+    if (hemisphere == negative) {
+        decimal = -decimal;
+    } else if (hemisphere != positive) {
+        return false;
+    }
+    result = decimal;
+    return true;
+}
+
+double optionalNumber(const QString &value, double factor = 1.0)
+{
+    bool ok = false;
+    const double number = value.toDouble(&ok);
+    return ok && std::isfinite(number) ? number * factor : qQNaN();
+}
+
+// value if min <= value < end, else NaN (also for NaN)
+double inRange(double value, double min, double end)
+{
+    return value >= min && value < end ? value : qQNaN();
+}
+
+bool parsePosition(const QStringList &f, int latIndex, double &lat, double &lon)
+{
+    return parseCoordinate(f.at(latIndex), f.at(latIndex + 1), QLatin1StringView("N"), QLatin1StringView("S"), 90.0, lat)
+        && parseCoordinate(f.at(latIndex + 2), f.at(latIndex + 3), QLatin1StringView("E"), QLatin1StringView("W"), 180.0, lon);
+}
+
+// "hhmmss" with an optional fraction of a second; digits past milliseconds are dropped.
+QTime parseTime(QStringView value)
+{
+    if (value.size() < 6 || !isDigits(value.first(6)) || (value.size() > 6 && (value.at(6) != u'.' || !isDigits(value.sliced(7))))) {
+        return QTime();
+    }
+    const int msec = value.mid(7, 3).toString().leftJustified(3, QLatin1Char('0')).toInt();
+    return QTime(value.first(2).toInt(), value.sliced(2, 2).toInt(), value.sliced(4, 2).toInt(), msec);
+}
+
+constexpr double knotsToMetresPerSecond = 1852.0 / 3600.0;
+}
+
+bool Nmea::update(GeoFix &fix, const QString &sentence)
+{
+    const QStringList f = sentence.left(sentence.indexOf(QLatin1Char('*'))).split(QLatin1Char(','));
+    const QStringView type = QStringView(f.at(0)).sliced(qMin<qsizetype>(3, f.at(0).size()));
+    double lat = 0;
+    double lon = 0;
+
+    if (type == u"RMC" && f.size() >= 10 && f.at(2) == QLatin1String("A") && parsePosition(f, 3, lat, lon)) {
+        fix.latitude = lat;
+        fix.longitude = lon;
+        fix.speed = inRange(optionalNumber(f.at(7), knotsToMetresPerSecond), 0.0, qInf());
+        fix.bearing = inRange(optionalNumber(f.at(8)), 0.0, 360.0);
+        const QDate date = QDate::fromString(f.at(9), QStringLiteral("ddMMyy")).addYears(100);
+        const QTime time = parseTime(f.at(1));
+        fix.timestamp = date.isValid() && time.isValid() ? QDateTime(date, time, QTimeZone::UTC) : QDateTime();
+        return true;
+    }
+    if (type == u"GGA" && f.size() >= 10 && !f.at(6).isEmpty() && f.at(6) != QLatin1String("0") && parsePosition(f, 2, lat, lon)) {
+        fix.latitude = lat;
+        fix.longitude = lon;
+        fix.altitude = optionalNumber(f.at(9));
+        return true;
+    }
+    return false;
+}
