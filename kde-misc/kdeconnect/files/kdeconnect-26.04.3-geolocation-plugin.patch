+#include "nmeaserver.h"
+
+#include <QDeadlineTimer>
+#include <QSignalSpy>
+#include <QTcpSocket>
+#include <QTest>
+#include <QTimer>
+
+#include <memory>
+#include <vector>
+
+// Like QTRY_VERIFY, but without its 10 ms naps between event loop passes.
+template<typename Predicate>
+static bool spinUntil(Predicate done)
+{
+    QTimer wakeUp; // WaitForMoreEvents must not block past the deadline
+    wakeUp.start(50);
+    const QDeadlineTimer deadline(5000);
+    while (!done() && !deadline.hasExpired()) {
+        QCoreApplication::processEvents(QEventLoop::WaitForMoreEvents);
+    }
+    return done();
+}
+
+class NmeaServerTest : public QObject
+{
+    Q_OBJECT
+
+private Q_SLOTS:
+    void listensOnLocalhostOnly()
+    {
+        NmeaServer server;
+        QVERIFY(server.listen(0));
+        QVERIFY(server.isListening());
+        QVERIFY(server.port() != 0);
+        QCOMPARE(server.address(), QHostAddress(QHostAddress::LocalHost));
+    }
+
+    void broadcastsLinesToEveryClient()
+    {
+        NmeaServer server;
+        QVERIFY(server.listen(0));
+        QSignalSpy count(&server, &NmeaServer::clientCountChanged);
+
+        QTcpSocket a;
+        QTcpSocket b;
+        a.connectToHost(QHostAddress::LocalHost, server.port());
+        b.connectToHost(QHostAddress::LocalHost, server.port());
+        QTRY_COMPARE(server.clientCount(), 2);
+        QCOMPARE(count.last().at(0).toInt(), 2);
+
+        server.broadcast(QStringLiteral("$GPGSV,1,1,01,01,40,083,46*44"));
+        QTRY_VERIFY(a.canReadLine());
+        QTRY_VERIFY(b.canReadLine());
+        QCOMPARE(a.readLine(), QByteArray("$GPGSV,1,1,01,01,40,083,46*44\r\n"));
+        QCOMPARE(b.readLine(), QByteArray("$GPGSV,1,1,01,01,40,083,46*44\r\n"));
+
+        a.disconnectFromHost();
+        QTRY_COMPARE(server.clientCount(), 1);
+        QCOMPARE(count.last().at(0).toInt(), 1);
+    }
+
+    void closeDropsClients()
+    {
+        NmeaServer server;
+        QVERIFY(server.listen(0));
+        QTcpSocket a;
+        a.connectToHost(QHostAddress::LocalHost, server.port());
+        QTRY_COMPARE(server.clientCount(), 1);
+
+        server.close();
+        QVERIFY(!server.isListening());
+        QCOMPARE(server.clientCount(), 0);
+        QTRY_COMPARE(a.state(), QAbstractSocket::UnconnectedState);
+    }
+
+    void deletingTheServerDropsClients()
+    {
+        auto *server = new NmeaServer;
+        QVERIFY(server->listen(0));
+        QTcpSocket a;
+        a.connectToHost(QHostAddress::LocalHost, server->port());
+        QTRY_COMPARE(server->clientCount(), 1);
+
+        delete server;
+        QTRY_COMPARE(a.state(), QAbstractSocket::UnconnectedState);
+    }
+
+    void incomingDataIsDiscarded()
+    {
+        NmeaServer server;
+        QVERIFY(server.listen(0));
+        QTcpSocket a;
+        a.connectToHost(QHostAddress::LocalHost, server.port());
+        QTRY_COMPARE(server.clientCount(), 1);
+        const QList<QTcpSocket *> accepted = server.findChildren<QTcpSocket *>();
+        QCOMPARE(accepted.size(), 1);
+        QSignalSpy received(accepted.first(), &QIODevice::readyRead);
+
+        a.write(QByteArray(64 * 1024, 'x'));
+        QTRY_VERIFY(received.count() > 0);
+        QCOMPARE(accepted.first()->bytesAvailable(), qint64(0)); // nothing piles up
+
+        server.broadcast(QStringLiteral("$GPGSV,1,1,01,01,40,083,46*44"));
+        QTRY_VERIFY(a.canReadLine());
+        QCOMPARE(a.readLine(), QByteArray("$GPGSV,1,1,01,01,40,083,46*44\r\n"));
+    }
+
+    void clientThatDoesNotReadIsDropped()
+    {
+        NmeaServer server;
+        QVERIFY(server.listen(0));
+        QTcpSocket reader;
+        QTcpSocket sleeper;
+        sleeper.setReadBufferSize(1024); // Qt stops reading from the kernel once full
+        reader.connectToHost(QHostAddress::LocalHost, server.port());
+        QTRY_COMPARE(server.clientCount(), 1);
+        sleeper.connectToHost(QHostAddress::LocalHost, server.port());
+        QTRY_COMPARE(server.clientCount(), 2);
+
+        qint64 expected = 0;
+        qint64 received = 0;
+        connect(&reader, &QIODevice::readyRead, &reader, [&reader, &received]() {
+            received += reader.readAll().size();
+        });
+        // Fill the kernel buffers of the sleeper; the server's own buffer for it
+        // then grows until the limit is exceeded. The reader keeps up.
+        const QString chunk(8 * 1024, QLatin1Char('x'));
+        for (int i = 0; i < 4000 && server.clientCount() == 2; ++i) {
+            server.broadcast(chunk);
+            expected += chunk.size() + 2;
+            QVERIFY(spinUntil([&]() {
+                return received == expected;
+            }));
+        }
+        QCOMPARE(server.clientCount(), 1);
+        sleeper.setReadBufferSize(0); // read on: now it sees the connection is gone
+        QTRY_COMPARE(sleeper.state(), QAbstractSocket::UnconnectedState);
+        QCOMPARE(reader.state(), QAbstractSocket::ConnectedState);
+    }
+
+    void connectionsBeyondTheLimitAreClosed()
+    {
+        NmeaServer server;
+        QVERIFY(server.listen(0));
+        std::vector<std::unique_ptr<QTcpSocket>> clients;
+        for (int i = 0; i < NmeaServer::MaxClients; ++i) {
+            clients.push_back(std::make_unique<QTcpSocket>());
+            clients.back()->connectToHost(QHostAddress::LocalHost, server.port());
+            QTRY_COMPARE(server.clientCount(), i + 1);
+        }
+        QCOMPARE(server.clientCount(), 16);
+        QSignalSpy count(&server, &NmeaServer::clientCountChanged);
+
+        QTcpSocket extra;
+        extra.connectToHost(QHostAddress::LocalHost, server.port());
+        QTRY_COMPARE(extra.state(), QAbstractSocket::UnconnectedState);
+        QCOMPARE(server.clientCount(), 16);
+        QCOMPARE(count.count(), 0);
+        for (const auto &client : clients) {
+            QCOMPARE(client->state(), QAbstractSocket::ConnectedState);
+        }
+    }
+
+    void broadcastWithoutClientsDoesNothing()
+    {
+        NmeaServer server;
+        QVERIFY(server.listen(0));
+        server.broadcast(QStringLiteral("$GPGSV,1,1,01,01,40,083,46*44"));
+        QCOMPARE(server.clientCount(), 0);
+        server.close(); // close without clients
+        QVERIFY(!server.isListening());
+    }
+
+    void portInUseFails()
+    {
+        NmeaServer first;
+        QVERIFY(first.listen(0));
+        NmeaServer second;
+        QVERIFY(!second.listen(first.port()));
+        QVERIFY(!second.errorString().isEmpty());
+    }
+};
+
+QTEST_GUILESS_MAIN(NmeaServerTest)
+#include "nmeaservertest.moc"
