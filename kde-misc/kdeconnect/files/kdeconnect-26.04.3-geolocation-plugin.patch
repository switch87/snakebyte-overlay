@@ -0,0 +1,493 @@
+/**
+ * SPDX-FileCopyrightText: 2026 Gert Pellin <gert@pellin.be>
+ *
+ * SPDX-License-Identifier: GPL-2.0-only OR GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
+ */
+
+#include "geolocationplugin.h"
+#include "testdaemon.h"
+#include "testdevice.h"
+
+#include <core/backends/linkprovider.h>
+#include <core/kdeconnectconfig.h>
+
+#include <QDBusConnection>
+#include <QDBusConnectionInterface>
+#include <QDBusMessage>
+#include <QDBusPendingCall>
+#include <QDeadlineTimer>
+#include <QDir>
+#include <QLoggingCategory>
+#include <QMetaProperty>
+#include <QPointer>
+#include <QRegularExpression>
+#include <QSignalSpy>
+#include <QStandardPaths>
+#include <QTcpServer>
+#include <QTcpSocket>
+#include <QTest>
+#include <QThread>
+
+static const QString RMC = QStringLiteral("$GNRMC,123519.00,A,5046.8360,N,00527.8520,E,10.0,271.5,061026,,,A*7B");
+static const QString GGA = QStringLiteral("$GNGGA,123519.00,5046.8360,N,00527.8520,E,1,08,0.9,108.4,M,46.9,M,,*7D");
+
+// TestDevice is always reachable; this one can drop off the network.
+class GeoTestDevice : public TestDevice
+{
+public:
+    using TestDevice::TestDevice;
+    bool isReachable() const override
+    {
+        return reachable;
+    }
+    bool reachable = true;
+};
+
+// Calls the plugin over the (test) session bus from its own bus connection,
+// so the plugin sees a separate caller. The connection is closed on destruction.
+class DbusCaller
+{
+public:
+    DbusCaller(GeolocationPlugin *plugin, const QString &name)
+        : m_name(name)
+        , m_connection(QDBusConnection::connectToBus(QDBusConnection::SessionBus, name))
+    {
+        QDBusConnection::sessionBus().registerObject(path(), plugin, QDBusConnection::ExportScriptableSlots | QDBusConnection::ExportScriptableInvokables);
+    }
+    ~DbusCaller()
+    {
+        leave();
+        QDBusConnection::sessionBus().unregisterObject(path());
+    }
+    // Closes the connection and returns once the bus has forgotten its name,
+    // without running this thread's event loop (so the plugin sees nothing yet).
+    void leave()
+    {
+        const QString uniqueName = m_connection.baseService();
+        m_connection = QDBusConnection(QString()); // the bus connection closes with its last reference
+        QDBusConnection::disconnectFromBus(m_name);
+        QDBusConnection witness = QDBusConnection::connectToBus(QDBusConnection::SessionBus, QStringLiteral("witness"));
+        const QDeadlineTimer deadline(5000);
+        while (!uniqueName.isEmpty() && witness.interface()->isServiceRegistered(uniqueName) && !deadline.hasExpired()) {
+            QThread::msleep(5);
+        }
+        QDBusConnection::disconnectFromBus(QStringLiteral("witness"));
+    }
+    bool call(const QString &method)
+    {
+        QDBusPendingCall pending = m_connection.asyncCall(methodCall(method));
+        // the plugin answers from this thread's event loop
+        const bool finished = QTest::qWaitFor([&pending]() {
+            return pending.isFinished();
+        });
+        return finished && !pending.isError();
+    }
+
+    // Like dbus-send without --print-reply: does not wait for the plugin.
+    // Returns once the bus has routed the call (a later round trip on the
+    // same connection is answered after it), without running our event loop.
+    void send(const QString &method)
+    {
+        QVERIFY(m_connection.send(methodCall(method)));
+        QVERIFY(m_connection.interface()->isServiceRegistered(m_connection.baseService()));
+    }
+
+private:
+    static QString path()
+    {
+        return QStringLiteral("/geolocationtest");
+    }
+    static QDBusMessage methodCall(const QString &method)
+    {
+        return QDBusMessage::createMethodCall(QDBusConnection::sessionBus().baseService(),
+                                              path(),
+                                              QStringLiteral("org.kde.kdeconnect.device.geolocation"),
+                                              method);
+    }
+    QString m_name;
+    QDBusConnection m_connection;
+};
+
+class GeolocationPluginTest : public QObject
+{
+    Q_OBJECT
+
+private:
+    TestDaemon *m_daemon = nullptr;
+    GeoTestDevice *m_device = nullptr;
+    GeolocationPlugin *m_plugin = nullptr;
+    quint16 m_port = 0;
+
+    static NetworkPacket nmeaPacket(const QString &sentence)
+    {
+        return NetworkPacket(PACKET_TYPE_GEOLOCATION_NMEA, {{QStringLiteral("nmea"), sentence}});
+    }
+
+    quint16 freePort()
+    {
+        QTcpServer probe;
+        probe.listen(QHostAddress::LocalHost, 0);
+        return probe.serverPort();
+    }
+
+    void enableOutput(bool enabled)
+    {
+        m_plugin->config()->set(QStringLiteral("nmeaPort"), m_port);
+        m_plugin->config()->set(QStringLiteral("nmeaEnabled"), enabled);
+        QMetaObject::invokeMethod(m_plugin, "applyConfig");
+    }
+
+private Q_SLOTS:
+    void initTestCase()
+    {
+        QStandardPaths::setTestModeEnabled(true);
+        // settings of earlier runs persist in ~/.qttest
+        QDir config = KdeConnectConfig::instance().pluginConfigDir(QStringLiteral("geolocationtestdevice"), QStringLiteral("kdeconnect_geolocation"));
+        QVERIFY(config.removeRecursively());
+        m_daemon = new TestDaemon(this);
+    }
+
+    void init()
+    {
+        m_device = new GeoTestDevice(this, QStringLiteral("geolocationtestdevice"));
+        const QVariantList args{QVariant::fromValue<Device *>(m_device),
+                                QStringLiteral("kdeconnect_geolocation"),
+                                QStringList{PACKET_TYPE_GEOLOCATION_REQUEST},
+                                QStringLiteral("mark-location")};
+        m_plugin = new GeolocationPlugin(m_device, args);
+        m_port = freePort();
+    }
+
+    void cleanup()
+    {
+        if (m_plugin) {
+            m_plugin->config()->set(QStringLiteral("nmeaEnabled"), false);
+            delete m_plugin;
+        }
+        delete m_device;
+    }
+
+    void outputIsOffByDefault()
+    {
+        QVERIFY(!m_plugin->isNmeaServerListening());
+    }
+
+    void dbusPathContainsDeviceId()
+    {
+        QCOMPARE(m_plugin->dbusPath(), QStringLiteral("/modules/kdeconnect/devices/geolocationtestdevice/geolocation"));
+    }
+
+    void clientTriggersEnableAndReceivesSentences()
+    {
+        enableOutput(true);
+        QVERIFY(m_plugin->isNmeaServerListening());
+
+        QTcpSocket client;
+        client.connectToHost(QHostAddress::LocalHost, m_port);
+        QTRY_VERIFY(m_device->getLastPacket());
+        QCOMPARE(m_device->getLastPacket()->type(), PACKET_TYPE_GEOLOCATION_REQUEST);
+        QCOMPARE(m_device->getLastPacket()->get<bool>(QStringLiteral("enable")), true);
+        QVERIFY(m_plugin->isActive());
+
+        QSignalSpy changed(m_plugin, &GeolocationPlugin::locationChanged);
+        m_plugin->receivePacket(nmeaPacket(RMC + QStringLiteral("\r\n")));
+        m_plugin->receivePacket(nmeaPacket(GGA));
+        QTRY_VERIFY(client.canReadLine());
+        QCOMPARE(client.readLine(), (RMC + QStringLiteral("\r\n")).toLatin1());
+        QCOMPARE(changed.count(), 2);
+        QCOMPARE(m_plugin->latitude(), 50.0 + 46.836 / 60.0);
+        QCOMPARE(m_plugin->longitude(), 5.0 + 27.852 / 60.0);
+        QCOMPARE(m_plugin->altitude(), 108.4);
+        QCOMPARE(m_plugin->speed(), 10.0 * 1852.0 / 3600.0);
+        QCOMPARE(m_plugin->bearing(), 271.5);
+        QCOMPARE(m_plugin->timestamp(), QDateTime(QDate(2026, 10, 6), QTime(12, 35, 19), QTimeZone::UTC).toMSecsSinceEpoch());
+    }
+
+    void invalidAndForeignPacketsAreIgnored()
+    {
+        enableOutput(true);
+        QTcpSocket client;
+        client.connectToHost(QHostAddress::LocalHost, m_port);
+        QTRY_VERIFY(m_plugin->isActive());
+
+        QSignalSpy changed(m_plugin, &GeolocationPlugin::locationChanged);
+        // Both logging branches (category on and off) must run for full branch coverage.
+        QLoggingCategory::setFilterRules(QStringLiteral("kdeconnect.plugin.geolocation.debug=true"));
+        // logged without its content (it may hold a location)
+        QTest::ignoreMessage(QtDebugMsg, "dropping invalid NMEA sentence of 16 characters");
+        m_plugin->receivePacket(nmeaPacket(QStringLiteral("$GNRMC,broken*00")));
+        QLoggingCategory::setFilterRules(QStringLiteral("kdeconnect.plugin.geolocation.debug=false"));
+        m_plugin->receivePacket(nmeaPacket(QStringLiteral("$GNRMC,broken*01"))); // not logged
+        m_plugin->receivePacket(NetworkPacket(QStringLiteral("kdeconnect.ping")));
+        m_plugin->receivePacket(nmeaPacket(QStringLiteral("$GPGSV,1,1,01,01,40,083,46*44")));
+        QTRY_VERIFY(client.canReadLine()); // the valid GSV is relayed
+        QCOMPARE(client.readLine(), QByteArray("$GPGSV,1,1,01,01,40,083,46*44\r\n"));
+        QVERIFY(!client.canReadLine());
+        QCOMPARE(changed.count(), 0);
+        QVERIFY(qIsNaN(m_plugin->latitude()));
+        QCOMPARE(m_plugin->timestamp(), qint64(0));
+    }
+
+    void dbusStartStop()
+    {
+        m_plugin->setStopDelayForTesting(0);
+        m_plugin->start();
+        QVERIFY(m_device->getLastPacket());
+        QCOMPARE(m_device->getLastPacket()->get<bool>(QStringLiteral("enable")), true);
+        m_plugin->stop();
+        QTRY_COMPARE(m_device->getLastPacket()->get<bool>(QStringLiteral("enable")), false);
+        QVERIFY(!m_plugin->isActive());
+    }
+
+    void isActiveNotifiesChanges()
+    {
+        const QMetaObject *meta = m_plugin->metaObject();
+        const QMetaProperty property = meta->property(meta->indexOfProperty("isActive"));
+        QVERIFY(property.hasNotifySignal());
+        QCOMPARE(property.notifySignal().name(), QByteArray("activeChanged"));
+
+        QSignalSpy spy(m_plugin, SIGNAL(activeChanged(bool)));
+        QVERIFY(spy.isValid());
+        m_plugin->setStopDelayForTesting(0);
+        m_plugin->start();
+        QCOMPARE(spy.count(), 1);
+        QCOMPARE(spy.last().at(0).toBool(), true);
+        m_plugin->stop();
+        QTRY_COMPARE(spy.count(), 2);
+        QCOMPARE(spy.last().at(0).toBool(), false);
+    }
+
+    void dbusCallersAreCountedSeparately()
+    {
+        m_plugin->setStopDelayForTesting(0);
+        DbusCaller a(m_plugin, QStringLiteral("callerA"));
+        DbusCaller b(m_plugin, QStringLiteral("callerB"));
+
+        QVERIFY(a.call(QStringLiteral("start")));
+        QVERIFY(m_plugin->isActive());
+        QVERIFY(b.call(QStringLiteral("start")));
+        QVERIFY(a.call(QStringLiteral("stop")));
+        QTest::qWait(50); // a stop would come with the (zero) stop delay
+        QVERIFY(m_plugin->isActive()); // b still wants it
+        QVERIFY(a.call(QStringLiteral("stop"))); // again: no effect
+        QVERIFY(b.call(QStringLiteral("stop")));
+        QTRY_VERIFY(!m_plugin->isActive());
+    }
+
+    void vanishedDbusCallerIsForgotten()
+    {
+        m_plugin->setStopDelayForTesting(0);
+        {
+            DbusCaller a(m_plugin, QStringLiteral("callerA"));
+            QVERIFY(a.call(QStringLiteral("start")));
+            QVERIFY(m_plugin->isActive());
+        } // a's bus connection goes away without stop()
+        QTRY_VERIFY(!m_plugin->isActive());
+        QCOMPARE(m_device->getLastPacket()->get<bool>(QStringLiteral("enable")), false);
+    }
+
+    void callerGoneBeforeStartIsHandledIsIgnored()
+    {
+        m_plugin->setStopDelayForTesting(0);
+        DbusCaller a(m_plugin, QStringLiteral("callerA"));
+        DbusCaller b(m_plugin, QStringLiteral("callerB"));
+        a.send(QStringLiteral("start"));
+        a.leave(); // gone before the plugin even sees start()
+        QVERIFY(b.call(QStringLiteral("stop"))); // handled after a's start()
+        QTest::qWait(50);
+        QVERIFY(!m_plugin->isActive());
+        QCOMPARE(m_device->getSentPackets(), 0);
+    }
+
+    void localAndDbusCallersAreIndependent()
+    {
+        m_plugin->setStopDelayForTesting(0);
+        DbusCaller a(m_plugin, QStringLiteral("callerA"));
+        QVERIFY(a.call(QStringLiteral("start")));
+        m_plugin->start(); // not from D-Bus
+        QVERIFY(a.call(QStringLiteral("stop")));
+        QTest::qWait(50);
+        QVERIFY(m_plugin->isActive());
+        m_plugin->stop();
+        QTRY_VERIFY(!m_plugin->isActive());
+    }
+
+    void reconnectResendsEnable()
+    {
+        m_plugin->start();
+        const int before = m_device->getSentPackets();
+        m_plugin->connected();
+        QCOMPARE(m_device->getSentPackets(), before + 1);
+        QVERIFY(m_device->getLastPacket());
+        QCOMPARE(m_device->getLastPacket()->get<bool>(QStringLiteral("enable")), true);
+    }
+
+    // The phone forgets the request when its connection is re-established. If
+    // the device stays reachable meanwhile, its plugins are not reloaded and
+    // connected() is not called; the device only signals linksChanged().
+    void newLinkResendsEnable()
+    {
+        Q_EMIT m_device->linksChanged(); // idle: nothing to ask again
+        QCOMPARE(m_device->getSentPackets(), 0);
+
+        m_plugin->start();
+        const int before = m_device->getSentPackets();
+        Q_EMIT m_device->linksChanged();
+        QCOMPARE(m_device->getSentPackets(), before + 1);
+        QVERIFY(m_device->getLastPacket());
+        QCOMPARE(m_device->getLastPacket()->type(), PACKET_TYPE_GEOLOCATION_REQUEST);
+        QCOMPARE(m_device->getLastPacket()->get<bool>(QStringLiteral("enable")), true);
+    }
+
+    // The LAN backend does not create a new link when a device connects again:
+    // it gives the existing link the new socket and offers it again. The
+    // device has to signal that as well.
+    void reconnectionOverAnExistingLinkSignalsLinksChanged()
+    {
+        // In test mode the only backend is the loopback one, which connects
+        // this computer to itself.
+        QCOMPARE(m_daemon->getLinkProviders().size(), 1);
+        LinkProvider *loopback = *m_daemon->getLinkProviders().cbegin();
+        Device *self = m_daemon->getDevice(KdeConnectConfig::instance().deviceId());
+        QVERIFY(self);
+        QSignalSpy connections(loopback, &LinkProvider::onConnectionReceived);
+        loopback->onNetworkChange(); // a new link, the daemon adds it to self
+        QCOMPARE(connections.size(), 1);
+        auto *link = static_cast<DeviceLink *>(connections.at(0).at(0).value<QObject *>());
+        QVERIFY(link);
+
+        QSignalSpy linksChanged(self, &Device::linksChanged);
+        self->addLink(link); // what the daemon does when that link is offered again
+        QCOMPARE(linksChanged.size(), 1);
+    }
+
+    void disablingClosesServerAndPortChangeRelistens()
+    {
+        enableOutput(true);
+        QVERIFY(m_plugin->isNmeaServerListening());
+        m_port = freePort();
+        enableOutput(true); // new port: listens again
+        QCOMPARE(m_plugin->nmeaServerPort(), m_port);
+        enableOutput(true); // unchanged: stays listening
+        QCOMPARE(m_plugin->nmeaServerPort(), m_port);
+        enableOutput(false);
+        QVERIFY(!m_plugin->isNmeaServerListening());
+    }
+
+    void destroyingActivePluginStopsTheDevice()
+    {
+        m_plugin->start();
+        const int before = m_device->getSentPackets();
+        delete m_plugin;
+        m_plugin = nullptr;
+        QCOMPARE(m_device->getSentPackets(), before + 1);
+        QVERIFY(m_device->getLastPacket());
+        QCOMPARE(m_device->getLastPacket()->type(), PACKET_TYPE_GEOLOCATION_REQUEST);
+        QCOMPARE(m_device->getLastPacket()->get<bool>(QStringLiteral("enable")), false);
+    }
+
+    void destroyingActivePluginOnUnpairedDeviceSendsNothing()
+    {
+        m_plugin->start();
+        QVERIFY(m_device->isPaired()); // TestDevice starts paired
+        m_device->unpair(); // Device::sendPacket asserts isPaired() for non-pair packets
+        QVERIFY(!m_device->isPaired());
+        const int before = m_device->getSentPackets();
+        delete m_plugin;
+        m_plugin = nullptr;
+        QCOMPARE(m_device->getSentPackets(), before);
+    }
+
+    void destroyingActivePluginOnUnreachableDeviceSendsNothing()
+    {
+        m_plugin->start();
+        m_device->reachable = false;
+        const int before = m_device->getSentPackets();
+        delete m_plugin;
+        m_plugin = nullptr;
+        QCOMPARE(m_device->getSentPackets(), before);
+    }
+
+    void destroyingPluginWithConnectedClientStopsOnce()
+    {
+        enableOutput(true);
+        QTcpSocket client;
+        client.connectToHost(QHostAddress::LocalHost, m_port);
+        QTRY_VERIFY(m_plugin->isActive());
+        const int before = m_device->getSentPackets();
+        delete m_plugin; // ~NmeaServer drops the client after the tracker is gone
+        m_plugin = nullptr;
+        QCOMPARE(m_device->getSentPackets(), before + 1);
+        QCOMPARE(m_device->getLastPacket()->get<bool>(QStringLiteral("enable")), false);
+        QTRY_COMPARE(client.state(), QAbstractSocket::UnconnectedState);
+    }
+
+    void destroyingIdlePluginSendsNothing()
+    {
+        delete m_plugin;
+        m_plugin = nullptr;
+        QCOMPARE(m_device->getSentPackets(), 0);
+    }
+
+    void destroyingDeviceWithActivePluginSendsNothing()
+    {
+        m_plugin->start();
+        QVERIFY(m_plugin->isActive());
+        QCOMPARE(m_plugin->parent(), m_device);
+        // ~Device frees its links before ~QObject deletes the plugin (a child):
+        // the plugin must not send then. Under ASan/valgrind a send is a use-after-free.
+        QPointer<GeolocationPlugin> plugin = m_plugin;
+        delete m_device;
+        m_device = nullptr;
+        m_plugin = nullptr;
+        QVERIFY(plugin.isNull());
+    }
+
+    void invalidPortIsRejected_data()
+    {
+        QTest::addColumn<int>("port");
+        QTest::newRow("zero") << 0;
+        QTest::newRow("too large") << 70000;
+    }
+
+    void invalidPortIsRejected()
+    {
+        QFETCH(int, port);
+        enableOutput(true);
+        QVERIFY(m_plugin->isNmeaServerListening());
+
+        const QRegularExpression notification(QStringLiteral("geolocationServerFailed.*Invalid port %1 ").arg(port));
+        QTest::ignoreMessage(QtWarningMsg, QStringLiteral("invalid port %1").arg(port).toUtf8().constData());
+        QTest::ignoreMessage(QtDebugMsg, notification);
+        m_plugin->config()->set(QStringLiteral("nmeaPort"), port);
+        QMetaObject::invokeMethod(m_plugin, "applyConfig");
+        QVERIFY(!m_plugin->isNmeaServerListening());
+
+        // same with the warning category switched off: both logging branches must run for full branch coverage
+        QLoggingCategory::setFilterRules(QStringLiteral("kdeconnect.plugin.geolocation.warning=false"));
+        QTest::ignoreMessage(QtDebugMsg, notification);
+        QMetaObject::invokeMethod(m_plugin, "applyConfig");
+        QVERIFY(!m_plugin->isNmeaServerListening());
+        QLoggingCategory::setFilterRules(QString());
+    }
+
+    void portInUseIsReportedNotFatal()
+    {
+        QTcpServer blocker;
+        QVERIFY(blocker.listen(QHostAddress::LocalHost, m_port));
+        QTest::ignoreMessage(QtWarningMsg, QRegularExpression(QStringLiteral("^cannot listen on port %1 ").arg(m_port)));
+        enableOutput(true);
+        QVERIFY(!m_plugin->isNmeaServerListening());
+
+        // same failure with the warning category switched off: both logging branches must run for full branch coverage
+        QLoggingCategory::setFilterRules(QStringLiteral("kdeconnect.plugin.geolocation.warning=false"));
+        m_plugin->config()->set(QStringLiteral("nmeaEnabled"), false);
+        QMetaObject::invokeMethod(m_plugin, "applyConfig");
+        enableOutput(true);
+        QVERIFY(!m_plugin->isNmeaServerListening());
+        QLoggingCategory::setFilterRules(QString());
+    }
+};
+
+QTEST_MAIN(GeolocationPluginTest)
+#include "geolocationplugintest.moc"
