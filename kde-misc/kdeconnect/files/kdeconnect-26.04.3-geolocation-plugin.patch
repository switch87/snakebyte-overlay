+/**
+ * SPDX-FileCopyrightText: 2026 Gert Pellin <gert@pellin.be>
+ *
+ * SPDX-License-Identifier: GPL-2.0-only OR GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
+ */
+
+#pragma once
+
+#include "geofix.h"
+
+#include <QString>
+
+namespace Nmea
+{
+// NMEA allows 82 characters including CR LF; leave some slack.
+constexpr qsizetype MaxSentenceLength = 128;
+
+// "$...*hh" of at most MaxSentenceLength characters, only printable ASCII
+// between '$' and '*', and the XOR of those characters equal to the hex hh.
+bool hasValidChecksum(const QString &sentence);
+
+// Updates fix from a valid RMC (with status A) or GGA (with a fix) sentence.
+// RMC sets position, speed, course and timestamp; GGA sets position and
+// altitude but leaves the timestamp alone. Returns true if fix changed;
+// other sentence types leave fix untouched.
+bool update(GeoFix &fix, const QString &sentence);
+}
diff --git a/plugins/geolocation/nmeaserver.cpp b/plugins/geolocation/nmeaserver.cpp
new file mode 100644
index 000000000..b47aeb8d2
--- /dev/null
+++ b/plugins/geolocation/nmeaserver.cpp
@@ -0,0 +1,108 @@
+/**
+ * SPDX-FileCopyrightText: 2026 Gert Pellin <gert@pellin.be>
+ *
+ * SPDX-License-Identifier: GPL-2.0-only OR GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
+ */
+
+#include "nmeaserver.h"
+
+#include <QTcpSocket>
+
+NmeaServer::NmeaServer(QObject *parent)
+    : QObject(parent)
+{
+    connect(&m_server, &QTcpServer::newConnection, this, &NmeaServer::acceptClients);
+}
+
+NmeaServer::~NmeaServer()
+{
+    // Drop the clients while our members are still alive: their disconnected
+    // handlers touch m_clients.
+    close();
+}
+
+bool NmeaServer::listen(quint16 port)
+{
+    return m_server.listen(QHostAddress::LocalHost, port);
+}
+
+void NmeaServer::close()
+{
+    m_server.close();
+    const QList<QTcpSocket *> clients = m_clients;
+    for (QTcpSocket *client : clients) {
+        client->abort();
+        dropClient(client);
+    }
+}
+
+bool NmeaServer::isListening() const
+{
+    return m_server.isListening();
+}
+
+quint16 NmeaServer::port() const
+{
+    return m_server.serverPort();
+}
+
+QHostAddress NmeaServer::address() const
+{
+    return m_server.serverAddress();
+}
+
+QString NmeaServer::errorString() const
+{
+    return m_server.errorString();
+}
+
+int NmeaServer::clientCount() const
+{
+    return m_clients.size();
+}
+
+void NmeaServer::broadcast(const QString &sentence)
+{
+    const QByteArray line = sentence.toLatin1() + "\r\n";
+    const QList<QTcpSocket *> clients = m_clients;
+    for (QTcpSocket *client : clients) {
+        client->write(line);
+        // A client that does not read would make us buffer without limit.
+        if (client->bytesToWrite() > MaxPendingBytes) {
+            client->abort();
+            dropClient(client);
+        }
+    }
+}
+
+void NmeaServer::acceptClients()
+{
+    while (QTcpSocket *client = m_server.nextPendingConnection()) {
+        if (m_clients.size() >= MaxClients) {
+            client->abort();
+            client->deleteLater();
+            continue;
+        }
+        client->setParent(this);
+        m_clients.append(client);
+        // Clients have nothing to tell us: throw their input away instead of
+        // letting it pile up in the read buffer.
+        connect(client, &QIODevice::readyRead, client, [client]() {
+            client->skip(client->bytesAvailable());
+        });
+        connect(client, &QTcpSocket::disconnected, this, [this, client]() {
+            dropClient(client);
+        });
+        Q_EMIT clientCountChanged(m_clients.size());
+    }
+}
+
+void NmeaServer::dropClient(QTcpSocket *client)
+{
+    if (m_clients.removeOne(client)) {
+        client->deleteLater();
+        Q_EMIT clientCountChanged(m_clients.size());
+    }
+}
+
+#include "moc_nmeaserver.cpp"
diff --git a/plugins/geolocation/nmeaserver.h b/plugins/geolocation/nmeaserver.h
new file mode 100644
index 000000000..c1bf18445
--- /dev/null
+++ b/plugins/geolocation/nmeaserver.h
@@ -0,0 +1,47 @@
+/**
+ * SPDX-FileCopyrightText: 2026 Gert Pellin <gert@pellin.be>
+ *
+ * SPDX-License-Identifier: GPL-2.0-only OR GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
+ */
+
+#pragma once
+
+#include <QList>
+#include <QTcpServer>
+
+class QTcpSocket;
+
+// Serves NMEA 0183 sentences to up to MaxClients TCP clients on 127.0.0.1.
+class NmeaServer : public QObject
+{
+    Q_OBJECT
+
+public:
+    // Further connections are closed right away.
+    static constexpr int MaxClients = 16;
+    // A client with more unsent data than this is dropped.
+    static constexpr qint64 MaxPendingBytes = 64 * 1024;
+
+    explicit NmeaServer(QObject *parent = nullptr);
+    ~NmeaServer() override;
+
+    bool listen(quint16 port); // port 0 = any free port (tests)
+    void close();
+    bool isListening() const;
+    quint16 port() const;
+    QHostAddress address() const;
+    QString errorString() const;
+    int clientCount() const;
+
+    void broadcast(const QString &sentence); // appends "\r\n"
+
+Q_SIGNALS:
+    void clientCountChanged(int count);
+
+private:
+    void acceptClients();
+    void dropClient(QTcpSocket *client);
+
+    QTcpServer m_server;
+    QList<QTcpSocket *> m_clients;
+};
