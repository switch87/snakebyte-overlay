+
+#include "nmea.h"
+
+#include <QTest>
+#include <QTimeZone>
+
+// "$" + body + "*" + the correct checksum of body.
+static QString withChecksum(const QString &body)
+{
+    uint sum = 0;
+    for (const QChar c : body) {
+        sum ^= c.unicode();
+    }
+    return QLatin1Char('$') + body + QLatin1Char('*') + QString::number(sum, 16).toUpper().rightJustified(2, QLatin1Char('0'));
+}
+
+class NmeaTest : public QObject
+{
+    Q_OBJECT
+
+private Q_SLOTS:
+    void checksum_data()
+    {
+        QTest::addColumn<QString>("sentence");
+        QTest::addColumn<bool>("valid");
+        QTest::newRow("rmc") << QStringLiteral("$GNRMC,123519.00,A,5046.8360,N,00527.8520,E,10.0,271.5,061026,,,A*7B") << true;
+        QTest::newRow("lowercase hex") << QStringLiteral("$GNGGA,123519.00,,,,,0,00,99.9,,,,,,*4c") << true;
+        QTest::newRow("wrong checksum") << QStringLiteral("$GNRMC,123519.00,A,5046.8360,N,00527.8520,E,10.0,271.5,061026,,,A*7C") << false;
+        QTest::newRow("no dollar") << QStringLiteral("GNRMC,123519.00,A*7B") << false;
+        QTest::newRow("no star") << QStringLiteral("$GNRMC,123519.00,A") << false;
+        QTest::newRow("star not 3 from end") << QStringLiteral("$GNRMC*7BX") << false;
+        QTest::newRow("not hex") << QStringLiteral("$GNRMC,1*ZZ") << false;
+        QTest::newRow("empty") << QString() << false;
+        // The XOR of a pair of equal characters is 0, so these would pass a bare checksum test.
+        QTest::newRow("non-ASCII pair") << QStringLiteral("$GPGSV\u0100\u0100,1,1,01,01,40,083,46*44") << false;
+        QTest::newRow("embedded CR LF") << QStringLiteral("$GPGSV,1,1,01\r\n\r\n,01,40,083,46*44") << false;
+        QTest::newRow("checksum with sign") << QStringLiteral("$GPGSV,1,1,01,01,40,083,46E*+1") << false;
+        QTest::newRow("checksum with space") << QStringLiteral("$GPGSV,1,1,01,01,40,083,46E* 1") << false;
+        QTest::newRow("checksum with space after") << QStringLiteral("$GPGSV,1,1,01,01,40,083,46E*1 ") << false;
+    }
+
+    void checksum()
+    {
+        QFETCH(QString, sentence);
+        QFETCH(bool, valid);
+        QCOMPARE(Nmea::hasValidChecksum(sentence), valid);
+    }
+
+    void lengthIsLimited()
+    {
+        const QString longest = withChecksum(QStringLiteral("GPTXT,") + QString(118, QLatin1Char('A')));
+        QCOMPARE(longest.size(), 128);
+        QVERIFY(Nmea::hasValidChecksum(longest));
+        const QString tooLong = withChecksum(QStringLiteral("GPTXT,") + QString(119, QLatin1Char('A')));
+        QCOMPARE(tooLong.size(), 129);
+        QVERIFY(!Nmea::hasValidChecksum(tooLong));
+    }
+
+    void rmcNorthEast()
+    {
+        GeoFix fix;
+        QVERIFY(Nmea::update(fix, QStringLiteral("$GNRMC,123519.00,A,5046.8360,N,00527.8520,E,10.0,271.5,061026,,,A*7B")));
+        QCOMPARE(fix.latitude, 50.0 + 46.836 / 60.0);
+        QCOMPARE(fix.longitude, 5.0 + 27.852 / 60.0);
+        QCOMPARE(fix.speed, 10.0 * 1852.0 / 3600.0);
+        QCOMPARE(fix.bearing, 271.5);
+        QCOMPARE(fix.timestamp, QDateTime(QDate(2026, 10, 6), QTime(12, 35, 19), QTimeZone::UTC));
+        QVERIFY(qIsNaN(fix.altitude));
+    }
+
+    void rmcSouthWestWithoutSpeedAndCourse()
+    {
+        GeoFix fix;
+        fix.speed = 3.0;
+        fix.bearing = 90.0;
+        QVERIFY(Nmea::update(fix, QStringLiteral("$GPRMC,000001.00,A,1435.4100,S,12058.6200,W,,,010126,,,A*58")));
+        QCOMPARE(fix.latitude, -(14.0 + 35.41 / 60.0));
+        QCOMPARE(fix.longitude, -(120.0 + 58.62 / 60.0));
+        QVERIFY(qIsNaN(fix.speed));
+        QVERIFY(qIsNaN(fix.bearing));
+        QCOMPARE(fix.timestamp, QDateTime(QDate(2026, 1, 1), QTime(0, 0, 1), QTimeZone::UTC));
+    }
+
+    void rmcVoidIsIgnored()
+    {
+        GeoFix fix;
+        QVERIFY(!Nmea::update(fix, QStringLiteral("$GNRMC,123520.00,V,,,,,,,061026,,,N*67")));
+        QVERIFY(qIsNaN(fix.latitude));
+    }
+
+    void rmcTooShortIsIgnored()
+    {
+        GeoFix fix;
+        QVERIFY(!Nmea::update(fix, QStringLiteral("$GNRMC,123519.00,A,5046.8360,N*5D")));
+    }
+
+    void gga()
+    {
+        GeoFix fix;
+        QVERIFY(Nmea::update(fix, QStringLiteral("$GNGGA,123519.00,5046.8360,N,00527.8520,E,1,08,0.9,108.4,M,46.9,M,,*7D")));
+        QCOMPARE(fix.latitude, 50.0 + 46.836 / 60.0);
+        QCOMPARE(fix.longitude, 5.0 + 27.852 / 60.0);
+        QCOMPARE(fix.altitude, 108.4);
+        QVERIFY(!fix.timestamp.isValid());
+    }
+
+    void ggaWithoutFixIsIgnored()
+    {
+        GeoFix fix;
+        QVERIFY(!Nmea::update(fix, QStringLiteral("$GNGGA,123519.00,,,,,0,00,99.9,,,,,,*4C")));
+    }
+
+    void otherSentencesAreIgnored()
+    {
+        GeoFix fix;
+        QVERIFY(!Nmea::update(fix, QStringLiteral("$GPGSV,1,1,01,01,40,083,46*44")));
+        QVERIFY(!Nmea::update(fix, QStringLiteral("$GN*")));
+        QVERIFY(!Nmea::update(fix, QStringLiteral("$GNGGA,123519.00*00"))); // too short
+        QVERIFY(!Nmea::update(fix, QStringLiteral("$GNGGA,123519.00,5046.8360,N,00527.8520,E,,08,0.9,108.4,M*00"))); // empty quality
+    }
+
+    void coordinateMustBeInRange_data()
+    {
+        QTest::addColumn<QString>("lat");
+        QTest::addColumn<QString>("ns");
+        QTest::addColumn<QString>("lon");
+        QTest::addColumn<QString>("ew");
+        QTest::newRow("nan") << QStringLiteral("nan") << QStringLiteral("N") << QStringLiteral("00527.8520") << QStringLiteral("E");
+        QTest::newRow("inf") << QStringLiteral("5046.8360") << QStringLiteral("N") << QStringLiteral("inf") << QStringLiteral("E");
+        QTest::newRow("lat 99 deg 99 min") << QStringLiteral("9999.0") << QStringLiteral("N") << QStringLiteral("00527.8520") << QStringLiteral("E");
+        QTest::newRow("lon 999 deg 99 min") << QStringLiteral("5046.8360") << QStringLiteral("N") << QStringLiteral("99999.0") << QStringLiteral("E");
+        QTest::newRow("negative") << QStringLiteral("-5046.8") << QStringLiteral("N") << QStringLiteral("00527.8520") << QStringLiteral("E");
+        QTest::newRow("plus sign") << QStringLiteral("+5046.8") << QStringLiteral("N") << QStringLiteral("00527.8520") << QStringLiteral("E");
+        QTest::newRow("exponent") << QStringLiteral("1e2") << QStringLiteral("N") << QStringLiteral("00527.8520") << QStringLiteral("E");
+        QTest::newRow("two dots") << QStringLiteral("50.46.8") << QStringLiteral("N") << QStringLiteral("00527.8520") << QStringLiteral("E");
+        QTest::newRow("leading dot") << QStringLiteral(".5") << QStringLiteral("N") << QStringLiteral("00527.8520") << QStringLiteral("E");
+        QTest::newRow("minutes 60") << QStringLiteral("5060.0") << QStringLiteral("N") << QStringLiteral("00527.8520") << QStringLiteral("E");
+        QTest::newRow("lat 91") << QStringLiteral("9100.0") << QStringLiteral("S") << QStringLiteral("00527.8520") << QStringLiteral("E");
+        QTest::newRow("lat with E") << QStringLiteral("5046.8360") << QStringLiteral("E") << QStringLiteral("00527.8520") << QStringLiteral("N");
+        QTest::newRow("lat with W") << QStringLiteral("5046.8360") << QStringLiteral("W") << QStringLiteral("00527.8520") << QStringLiteral("E");
+        QTest::newRow("lon with S") << QStringLiteral("5046.8360") << QStringLiteral("N") << QStringLiteral("00527.8520") << QStringLiteral("S");
+        QTest::newRow("lon 181") << QStringLiteral("5046.8360") << QStringLiteral("N") << QStringLiteral("18100.0") << QStringLiteral("W");
+    }
+
+    void coordinateMustBeInRange()
+    {
+        QFETCH(QString, lat);
+        QFETCH(QString, ns);
+        QFETCH(QString, lon);
+        QFETCH(QString, ew);
+        GeoFix fix;
+        QVERIFY(!Nmea::update(fix, QStringLiteral("$GNRMC,123519.00,A,%1,%2,%3,%4,,,061026*00").arg(lat, ns, lon, ew)));
+        QVERIFY(qIsNaN(fix.latitude));
+    }
+
+    void coordinateLimitsAreValid()
+    {
+        GeoFix fix;
+        QVERIFY(Nmea::update(fix, QStringLiteral("$GNRMC,123519.00,A,9000.0,S,18000,W,,,061026*00")));
+        QCOMPARE(fix.latitude, -90.0);
+        QCOMPARE(fix.longitude, -180.0);
+        QVERIFY(Nmea::update(fix, QStringLiteral("$GNRMC,123519.00,A,5059.99,N,00000.,E,,,061026*00")));
+        QCOMPARE(fix.latitude, 50.0 + 59.99 / 60.0);
+        QCOMPARE(fix.longitude, 0.0);
+    }
+
+    void nonFiniteSpeedCourseAltitudeAreUnknown()
+    {
+        GeoFix fix;
+        QVERIFY(Nmea::update(fix, QStringLiteral("$GNRMC,123519.00,A,5046.8360,N,00527.8520,E,inf,-inf,061026*00")));
+        QVERIFY(qIsNaN(fix.speed));
+        QVERIFY(qIsNaN(fix.bearing));
+        QVERIFY(Nmea::update(fix, QStringLiteral("$GNRMC,123519.00,A,5046.8360,N,00527.8520,E,nan,nan,061026*00")));
+        QVERIFY(qIsNaN(fix.speed));
+        QVERIFY(qIsNaN(fix.bearing));
+        QVERIFY(Nmea::update(fix, QStringLiteral("$GNGGA,123519.00,5046.8360,N,00527.8520,E,1,08,0.9,inf,M,46.9,M,,*00")));
+        QVERIFY(qIsNaN(fix.altitude));
+    }
+
+    void speedAndCourseMustBeInRange_data()
+    {
+        QTest::addColumn<QString>("speed");
+        QTest::addColumn<QString>("course");
+        QTest::addColumn<double>("expectedSpeed"); // NaN = unknown
+        QTest::addColumn<double>("expectedCourse");
+        QTest::newRow("zero") << QStringLiteral("0.0") << QStringLiteral("0.0") << 0.0 << 0.0;
+        QTest::newRow("just below 360") << QStringLiteral("1.0") << QStringLiteral("359.9") << 1852.0 / 3600.0 << 359.9;
+        QTest::newRow("negative speed") << QStringLiteral("-1.0") << QStringLiteral("90.0") << qQNaN() << 90.0;
+        QTest::newRow("negative course") << QStringLiteral("1.0") << QStringLiteral("-0.5") << 1852.0 / 3600.0 << qQNaN();
+        QTest::newRow("course 360") << QStringLiteral("1.0") << QStringLiteral("360.0") << 1852.0 / 3600.0 << qQNaN();
+    }
+
+    void speedAndCourseMustBeInRange()
+    {
+        QFETCH(QString, speed);
+        QFETCH(QString, course);
+        QFETCH(double, expectedSpeed);
+        QFETCH(double, expectedCourse);
+        GeoFix fix;
+        QVERIFY(Nmea::update(fix, QStringLiteral("$GNRMC,123519.00,A,5046.8360,N,00527.8520,E,%1,%2,061026*00").arg(speed, course)));
+        QCOMPARE(qIsNaN(fix.speed), qIsNaN(expectedSpeed));
+        QCOMPARE(qIsNaN(fix.bearing), qIsNaN(expectedCourse));
+        if (!qIsNaN(expectedSpeed)) {
+            QCOMPARE(fix.speed, expectedSpeed);
+        }
+        if (!qIsNaN(expectedCourse)) {
+            QCOMPARE(fix.bearing, expectedCourse);
+        }
+    }
+
+    void timestamp_data()
+    {
+        QTest::addColumn<QString>("time");
+        QTest::addColumn<QString>("date");
+        QTest::addColumn<QDateTime>("expected");
+        const QDate day(2026, 10, 6);
+        QTest::newRow("whole seconds") << QStringLiteral("123519") << QStringLiteral("061026") << QDateTime(day, QTime(12, 35, 19), QTimeZone::UTC);
+        QTest::newRow("tenths") << QStringLiteral("123519.5") << QStringLiteral("061026") << QDateTime(day, QTime(12, 35, 19, 500), QTimeZone::UTC);
+        QTest::newRow("hundredths") << QStringLiteral("123519.50") << QStringLiteral("061026") << QDateTime(day, QTime(12, 35, 19, 500), QTimeZone::UTC);
+        QTest::newRow("milliseconds") << QStringLiteral("123519.123") << QStringLiteral("061026") << QDateTime(day, QTime(12, 35, 19, 123), QTimeZone::UTC);
+        QTest::newRow("beyond milliseconds") << QStringLiteral("123519.1239") << QStringLiteral("061026")
+                                             << QDateTime(day, QTime(12, 35, 19, 123), QTimeZone::UTC);
+        QTest::newRow("empty time") << QString() << QStringLiteral("061026") << QDateTime();
+        QTest::newRow("bad time") << QStringLiteral("126519.00") << QStringLiteral("061026") << QDateTime();
+        QTest::newRow("short time") << QStringLiteral("1235") << QStringLiteral("061026") << QDateTime();
+        QTest::newRow("letter in time") << QStringLiteral("12a519") << QStringLiteral("061026") << QDateTime();
+        QTest::newRow("seventh digit") << QStringLiteral("1235190") << QStringLiteral("061026") << QDateTime();
+        QTest::newRow("letter in fraction") << QStringLiteral("123519.5x") << QStringLiteral("061026") << QDateTime();
+        QTest::newRow("empty fraction") << QStringLiteral("123519.") << QStringLiteral("061026") << QDateTime(day, QTime(12, 35, 19), QTimeZone::UTC);
+        QTest::newRow("empty date") << QStringLiteral("123519.00") << QString() << QDateTime();
+    }
+
+    void timestamp()
+    {
+        QFETCH(QString, time);
+        QFETCH(QString, date);
+        QFETCH(QDateTime, expected);
+        GeoFix fix;
+        fix.timestamp = QDateTime(QDate(2000, 1, 1), QTime(0, 0), QTimeZone::UTC); // overwritten
+        QVERIFY(Nmea::update(fix, QStringLiteral("$GNRMC,%1,A,5046.8360,N,00527.8520,E,,,%2*00").arg(time, date)));
+        QCOMPARE(fix.timestamp.isValid(), expected.isValid());
+        if (expected.isValid()) {
+            QCOMPARE(fix.timestamp, expected);
+        }
+    }
+
+    void badCoordinateIsIgnored()
+    {
+        GeoFix fix;
+        // checksum is not checked by update(); the plugin checks it first
+        QVERIFY(!Nmea::update(fix, QStringLiteral("$GNRMC,123519.00,A,50x6.8360,N,00527.8520,E,,,061026*00")));
+        QVERIFY(!Nmea::update(fix, QStringLiteral("$GNRMC,123519.00,A,5046.8360,N,,E,,,061026*00")));
+        QVERIFY(!Nmea::update(fix, QStringLiteral("$GNGGA,123519.00,5046.8360,X,00527.8520,E,1,08,0.9,108.4,M*00")));
+        QVERIFY(qIsNaN(fix.latitude));
+    }
+};
+
+QTEST_GUILESS_MAIN(NmeaTest)
+#include "nmeatest.moc"
