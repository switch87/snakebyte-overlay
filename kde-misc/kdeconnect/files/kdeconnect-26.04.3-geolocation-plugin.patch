diff --git a/plugins/geolocation/README b/plugins/geolocation/README
new file mode 100644
index 000000000..05006af00
--- /dev/null
+++ b/plugins/geolocation/README
@@ -0,0 +1,31 @@
+The geolocation plugin receives the location of the other device (sent by the
+"Location sharing" plugin of KDE Connect for Android as NMEA 0183 sentences in
+kdeconnect.geolocation.nmea packets) and offers it to applications:
+
+- as an NMEA 0183 stream on a TCP port on localhost (127.0.0.1 only). This is
+  off by default; enable it and pick the port (default 10110) in the plugin
+  settings; each device needs its own port. Ports outside 1..65535 are
+  rejected with a warning and a notification. At most 16 clients are served
+  at a time; a client that does not keep up with the stream (more than 64 KiB
+  unsent) is disconnected.
+- on D-Bus: /modules/kdeconnect/devices/<id>/geolocation,
+  org.kde.kdeconnect.device.geolocation (properties latitude, longitude,
+  altitude, speed, bearing, timestamp, isActive; signals locationChanged,
+  activeChanged; methods start(), stop()). RMC sentences set the position,
+  speed, bearing and timestamp; GGA sentences set the position and altitude
+  but not the timestamp. Each caller of start() keeps the location running
+  until it calls stop() or leaves the bus, so "qdbus ... start" from a shell
+  stops about 30 seconds after qdbus exits; long-running clients call start()
+  and keep their bus connection. This works independently of the NMEA output
+  setting: any process of the session can already use KDE Connect's D-Bus
+  API.
+
+The device is asked to send its location (kdeconnect.geolocation.request
+{"enable": true}) only while a TCP client is connected or a D-Bus caller
+wants it. 30 seconds after that ends it is asked to stop ({"enable": false}).
+It is also told to stop when the plugin is unloaded while the location is
+active and the device is still paired and reachable.
+
+QMapShack: Realtime -> add source "GPS Tether", host localhost, port 10110,
+"auto. conn.". Other NMEA-over-TCP readers (gpsd: gpsd tcp://localhost:10110,
+OpenCPN, Navit) work the same way.
diff --git a/plugins/geolocation/demandtracker.cpp b/plugins/geolocation/demandtracker.cpp
new file mode 100644
index 000000000..44afcddff
--- /dev/null
+++ b/plugins/geolocation/demandtracker.cpp
@@ -0,0 +1,73 @@
+/**
+ * SPDX-FileCopyrightText: 2026 Gert Pellin <gert@pellin.be>
+ *
+ * SPDX-License-Identifier: GPL-2.0-only OR GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
+ */
+
+#include "demandtracker.h"
+
+DemandTracker::DemandTracker(QObject *parent)
+    : QObject(parent)
+{
+    m_stopTimer.setSingleShot(true);
+    m_stopTimer.setInterval(30000);
+    connect(&m_stopTimer, &QTimer::timeout, this, &DemandTracker::stop);
+}
+
+void DemandTracker::setStopDelay(int msec)
+{
+    m_stopTimer.setInterval(msec);
+}
+
+int DemandTracker::stopDelay() const
+{
+    return m_stopTimer.interval();
+}
+
+void DemandTracker::setClientCount(int count)
+{
+    m_clients = count;
+    evaluate();
+}
+
+void DemandTracker::setDbusDemand(bool wanted)
+{
+    m_dbus = wanted;
+    evaluate();
+}
+
+bool DemandTracker::isActive() const
+{
+    return m_active;
+}
+
+void DemandTracker::resend()
+{
+    if (m_active) {
+        Q_EMIT enableRequested(true);
+    }
+}
+
+void DemandTracker::evaluate()
+{
+    const bool wanted = m_clients > 0 || m_dbus;
+    if (wanted) {
+        m_stopTimer.stop();
+        if (!m_active) {
+            m_active = true;
+            Q_EMIT enableRequested(true);
+            Q_EMIT activeChanged(true);
+        }
+    } else if (m_active && !m_stopTimer.isActive()) {
+        m_stopTimer.start();
+    }
+}
+
+void DemandTracker::stop()
+{
+    m_active = false;
+    Q_EMIT enableRequested(false);
+    Q_EMIT activeChanged(false);
+}
+
+#include "moc_demandtracker.cpp"
diff --git a/plugins/geolocation/demandtracker.h b/plugins/geolocation/demandtracker.h
new file mode 100644
index 000000000..4493d61ac
--- /dev/null
+++ b/plugins/geolocation/demandtracker.h
@@ -0,0 +1,43 @@
+/**
+ * SPDX-FileCopyrightText: 2026 Gert Pellin <gert@pellin.be>
+ *
+ * SPDX-License-Identifier: GPL-2.0-only OR GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
+ */
+
+#pragma once
+
+#include <QObject>
+#include <QTimer>
+
+// Decides when the phone should send its location: as soon as anyone wants it
+// (TCP clients or a D-Bus start()), until stopDelay() ms after nobody does.
+class DemandTracker : public QObject
+{
+    Q_OBJECT
+
+public:
+    explicit DemandTracker(QObject *parent = nullptr);
+
+    void setStopDelay(int msec);
+    int stopDelay() const;
+
+    void setClientCount(int count);
+    void setDbusDemand(bool wanted);
+    bool isActive() const;
+
+    // Repeat enable(true) while active, e.g. after the phone reconnected.
+    void resend();
+
+Q_SIGNALS:
+    void enableRequested(bool enable);
+    void activeChanged(bool active);
+
+private:
+    void evaluate();
+    void stop();
+
+    int m_clients = 0;
+    bool m_dbus = false;
+    bool m_active = false;
+    QTimer m_stopTimer;
+};
diff --git a/plugins/geolocation/geofix.h b/plugins/geolocation/geofix.h
new file mode 100644
index 000000000..4b6cc45c7
