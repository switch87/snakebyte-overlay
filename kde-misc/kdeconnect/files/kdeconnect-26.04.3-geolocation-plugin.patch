@@ -0,0 +1,20 @@
+/**
+ * SPDX-FileCopyrightText: 2026 Gert Pellin <gert@pellin.be>
+ *
+ * SPDX-License-Identifier: GPL-2.0-only OR GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
+ */
+
+#pragma once
+
+#include <QDateTime>
+#include <QtNumeric>
+
+// Last known position, filled from RMC and GGA sentences. NaN = unknown.
+struct GeoFix {
+    double latitude = qQNaN();
+    double longitude = qQNaN();
+    double altitude = qQNaN(); // metres above mean sea level (GGA)
+    double speed = qQNaN(); // m/s
+    double bearing = qQNaN(); // degrees from true north
+    QDateTime timestamp; // UTC, from RMC only (GGA has no date)
+};
diff --git a/plugins/geolocation/geolocationplugin.cpp b/plugins/geolocation/geolocationplugin.cpp
new file mode 100644
index 000000000..c0b0723c2
--- /dev/null
+++ b/plugins/geolocation/geolocationplugin.cpp
@@ -0,0 +1,198 @@
+/**
+ * SPDX-FileCopyrightText: 2026 Gert Pellin <gert@pellin.be>
+ *
+ * SPDX-License-Identifier: GPL-2.0-only OR GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
+ */
+
+#include "geolocationplugin.h"
+
+#include "nmea.h"
+#include "plugin_geolocation_debug.h"
+
+#include <KLocalizedString>
+#include <QDBusConnection>
+#include <QDBusConnectionInterface>
+#include <QDBusMessage>
+#include <core/daemon.h>
+#include <core/device.h>
+
+GeolocationPlugin::GeolocationPlugin(QObject *parent, const QVariantList &args)
+    : KdeConnectPlugin(parent, args)
+{
+    connect(&m_server, &NmeaServer::clientCountChanged, &m_demand, &DemandTracker::setClientCount);
+    connect(&m_demand, &DemandTracker::enableRequested, this, &GeolocationPlugin::sendRequest);
+    connect(&m_demand, &DemandTracker::activeChanged, this, &GeolocationPlugin::activeChanged);
+    connect(config(), &KdeConnectPluginConfig::configChanged, this, &GeolocationPlugin::applyConfig);
+    m_callerWatcher.setConnection(QDBusConnection::sessionBus());
+    m_callerWatcher.setWatchMode(QDBusServiceWatcher::WatchForUnregistration);
+    connect(&m_callerWatcher, &QDBusServiceWatcher::serviceUnregistered, this, &GeolocationPlugin::removeCaller);
+    // Emitted by ~QObject of the device, after ~Device freed its links but
+    // before its children (this plugin) are deleted.
+    connect(device(), &QObject::destroyed, this, [this]() {
+        m_deviceGone = true;
+    });
+    // The phone forgets the request whenever its connection is re-established.
+    // While the device stays reachable that reloads no plugins (no connected()),
+    // the device only signals that its links changed. That includes a link going
+    // away while others remain; asking again then does no harm.
+    connect(device(), &Device::linksChanged, &m_demand, &DemandTracker::resend);
+    applyConfig();
+}
+
+GeolocationPlugin::~GeolocationPlugin()
+{
+    // Unloaded while the phone is sending (plugin disabled): tell it to stop.
+    // Not when the device itself is being destroyed (its internals are gone),
+    // nor once it is unpaired (Device::sendPacket asserts isPaired()) or
+    // unreachable (nothing to send over).
+    if (m_demand.isActive() && !m_deviceGone && device()->isPaired() && device()->isReachable()) {
+        sendRequest(false);
+    }
+}
+
+void GeolocationPlugin::applyConfig()
+{
+    if (!config()->getBool(QStringLiteral("nmeaEnabled"), false)) {
+        m_server.close();
+        return;
+    }
+    const int configuredPort = config()->getInt(QStringLiteral("nmeaPort"), 10110);
+    if (configuredPort < 1 || configuredPort > 65535) {
+        m_server.close();
+        qCWarning(KDECONNECT_PLUGIN_GEOLOCATION) << "invalid port" << configuredPort;
+        Daemon::instance()->sendSimpleNotification(QStringLiteral("geolocationServerFailed"),
+                                                   device()->name(),
+                                                   i18n("Invalid port %1 for the location", QString::number(configuredPort)),
+                                                   QStringLiteral("mark-location"));
+        return;
+    }
+    const quint16 port = static_cast<quint16>(configuredPort);
+    if (m_server.isListening() && m_server.port() == port) {
+        return;
+    }
+    m_server.close();
+    if (!m_server.listen(port)) {
+        qCWarning(KDECONNECT_PLUGIN_GEOLOCATION) << "cannot listen on port" << port << m_server.errorString();
+        Daemon::instance()->sendSimpleNotification(QStringLiteral("geolocationServerFailed"),
+                                                   device()->name(),
+                                                   i18n("Cannot offer the location on port %1: %2", QString::number(port), m_server.errorString()),
+                                                   QStringLiteral("mark-location"));
+    }
+}
+
+void GeolocationPlugin::receivePacket(const NetworkPacket &np)
+{
+    if (np.type() != PACKET_TYPE_GEOLOCATION_NMEA) {
+        return;
+    }
+    const QString sentence = np.get<QString>(QStringLiteral("nmea")).trimmed();
+    if (!Nmea::hasValidChecksum(sentence)) {
+        qCDebug(KDECONNECT_PLUGIN_GEOLOCATION) << "dropping invalid NMEA sentence of" << sentence.size() << "characters";
+        return;
+    }
+    m_server.broadcast(sentence);
+    if (Nmea::update(m_fix, sentence)) {
+        Q_EMIT locationChanged();
+    }
+}
+
+void GeolocationPlugin::connected()
+{
+    m_demand.resend();
+}
+
+void GeolocationPlugin::sendRequest(bool enable)
+{
+    NetworkPacket np(PACKET_TYPE_GEOLOCATION_REQUEST, {{QStringLiteral("enable"), enable}});
+    sendPacket(np);
+}
+
+double GeolocationPlugin::latitude() const
+{
+    return m_fix.latitude;
+}
+
+double GeolocationPlugin::longitude() const
+{
+    return m_fix.longitude;
+}
+
+double GeolocationPlugin::altitude() const
+{
+    return m_fix.altitude;
+}
+
+double GeolocationPlugin::speed() const
+{
+    return m_fix.speed;
+}
+
+double GeolocationPlugin::bearing() const
+{
+    return m_fix.bearing;
+}
+
+qint64 GeolocationPlugin::timestamp() const
+{
+    return m_fix.timestamp.isValid() ? m_fix.timestamp.toMSecsSinceEpoch() : 0;
+}
+
+bool GeolocationPlugin::isActive() const
+{
+    return m_demand.isActive();
+}
+
+QString GeolocationPlugin::caller() const
+{
+    return calledFromDBus() ? message().service() : QString();
+}
+
+void GeolocationPlugin::start()
+{
+    const QString name = caller();
+    if (!name.isEmpty()) {
+        m_callerWatcher.addWatchedService(name);
+        // A caller that did not wait for the reply may already be gone, and
+        // then we never see it leave. Asked after the watch was installed.
+        if (!connection().interface()->isServiceRegistered(name)) {
+            removeCaller(name);
+            return;
+        }
+    }
+    m_callers.insert(name);
+    m_demand.setDbusDemand(true);
+}
+
+void GeolocationPlugin::stop()
+{
+    removeCaller(caller());
+}
+
+void GeolocationPlugin::removeCaller(const QString &name)
+{
+    m_callerWatcher.removeWatchedService(name);
+    m_callers.remove(name);
+    m_demand.setDbusDemand(!m_callers.isEmpty());
+}
+
+bool GeolocationPlugin::isNmeaServerListening() const
+{
+    return m_server.isListening();
+}
+
+quint16 GeolocationPlugin::nmeaServerPort() const
+{
+    return m_server.port();
+}
+
+void GeolocationPlugin::setStopDelayForTesting(int msec)
+{
+    m_demand.setStopDelay(msec);
+}
+
+QString GeolocationPlugin::dbusPath() const
+{
+    return QLatin1String("/modules/kdeconnect/devices/%1/geolocation").arg(device()->id());
+}
+
+#include "moc_geolocationplugin.cpp"
diff --git a/plugins/geolocation/geolocationplugin.h b/plugins/geolocation/geolocationplugin.h
new file mode 100644
index 000000000..72fee31c1
--- /dev/null
+++ b/plugins/geolocation/geolocationplugin.h
@@ -0,0 +1,81 @@
+/**
+ * SPDX-FileCopyrightText: 2026 Gert Pellin <gert@pellin.be>
+ *
+ * SPDX-License-Identifier: GPL-2.0-only OR GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
+ */
+
+#pragma once
+
+#include "demandtracker.h"
+#include "geofix.h"
+#include "nmeaserver.h"
+
+#include <core/kdeconnectplugin.h>
+
+#include <QDBusContext>
+#include <QDBusServiceWatcher>
+#include <QSet>
+
+#define PACKET_TYPE_GEOLOCATION_NMEA QStringLiteral("kdeconnect.geolocation.nmea")
+#define PACKET_TYPE_GEOLOCATION_REQUEST QStringLiteral("kdeconnect.geolocation.request")
+
+class GeolocationPlugin : public KdeConnectPlugin, protected QDBusContext
+{
+    Q_OBJECT
+    Q_CLASSINFO("D-Bus Interface", "org.kde.kdeconnect.device.geolocation")
+    Q_PROPERTY(double latitude READ latitude NOTIFY locationChanged)
+    Q_PROPERTY(double longitude READ longitude NOTIFY locationChanged)
+    Q_PROPERTY(double altitude READ altitude NOTIFY locationChanged)
+    Q_PROPERTY(double speed READ speed NOTIFY locationChanged)
+    Q_PROPERTY(double bearing READ bearing NOTIFY locationChanged)
+    Q_PROPERTY(qint64 timestamp READ timestamp NOTIFY locationChanged)
+    Q_PROPERTY(bool isActive READ isActive NOTIFY activeChanged)
+
+public:
+    GeolocationPlugin(QObject *parent, const QVariantList &args);
+    ~GeolocationPlugin() override;
+
+    void receivePacket(const NetworkPacket &np) override;
+    void connected() override;
+    QString dbusPath() const override;
+
+    double latitude() const;
+    double longitude() const;
+    double altitude() const;
+    double speed() const;
+    double bearing() const;
+    qint64 timestamp() const; // ms since epoch (UTC), 0 = unknown
+    bool isActive() const;
+
+    // Each D-Bus caller keeps the location running until it calls stop() or
+    // leaves the bus. Calls from within the process count as one caller.
+    Q_SCRIPTABLE void start();
+    Q_SCRIPTABLE void stop();
+
+    bool isNmeaServerListening() const;
+    quint16 nmeaServerPort() const;
+    void setStopDelayForTesting(int msec);
+
+Q_SIGNALS:
+    Q_SCRIPTABLE void locationChanged();
+    Q_SCRIPTABLE void activeChanged(bool active);
+
+private Q_SLOTS:
+    void applyConfig();
+
+private:
+    void sendRequest(bool enable);
+    QString caller() const;
+    void removeCaller(const QString &name);
+
+    QSet<QString> m_callers;
+    QDBusServiceWatcher m_callerWatcher;
+
+    // Destroyed in reverse order: m_demand goes first, which removes its
+    // connections, so the clientCountChanged emitted while ~NmeaServer drops
+    // the clients reaches no one.
+    NmeaServer m_server;
+    DemandTracker m_demand;
+    GeoFix m_fix;
+    bool m_deviceGone = false;
+};
