+++ b/tests/geolocation/demandtrackertest.cpp
@@ -0,0 +1,134 @@
+/**
+ * SPDX-FileCopyrightText: 2026 Gert Pellin <gert@pellin.be>
+ *
+ * SPDX-License-Identifier: GPL-2.0-only OR GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
+ */
+
+#include "demandtracker.h"
+
+#include <QSignalSpy>
+#include <QTest>
+
+class DemandTrackerTest : public QObject
+{
+    Q_OBJECT
+
+private Q_SLOTS:
+    void defaultStopDelayIs30Seconds()
+    {
+        DemandTracker tracker;
+        QCOMPARE(tracker.stopDelay(), 30000);
+    }
+
+    void firstClientStartsLastClientStopsAfterDelay()
+    {
+        DemandTracker tracker;
+        tracker.setStopDelay(50);
+        QSignalSpy spy(&tracker, &DemandTracker::enableRequested);
+
+        tracker.setClientCount(1);
+        QCOMPARE(spy.count(), 1);
+        QCOMPARE(spy.last().at(0).toBool(), true);
+        QVERIFY(tracker.isActive());
+
+        tracker.setClientCount(2); // still active: no new request
+        QCOMPARE(spy.count(), 1);
+
+        tracker.setClientCount(0);
+        QCOMPARE(spy.count(), 1); // not yet
+        QVERIFY(tracker.isActive());
+        QTRY_COMPARE(spy.count(), 2);
+        QCOMPARE(spy.last().at(0).toBool(), false);
+        QVERIFY(!tracker.isActive());
+    }
+
+    void comingBackWithinDelayCancelsStop()
+    {
+        DemandTracker tracker;
+        tracker.setStopDelay(50);
+        QSignalSpy spy(&tracker, &DemandTracker::enableRequested);
+
+        tracker.setClientCount(1);
+        tracker.setClientCount(0);
+        tracker.setClientCount(1);
+        QTest::qWait(100);
+        QCOMPARE(spy.count(), 1); // only the first enable
+        QVERIFY(tracker.isActive());
+    }
+
+    void dbusDemandCountsLikeAClient()
+    {
+        DemandTracker tracker;
+        tracker.setStopDelay(0);
+        QSignalSpy spy(&tracker, &DemandTracker::enableRequested);
+
+        tracker.setDbusDemand(true);
+        QCOMPARE(spy.count(), 1);
+        tracker.setClientCount(1);
+        tracker.setClientCount(0); // D-Bus still wants it
+        QTest::qWait(20);
+        QCOMPARE(spy.count(), 1);
+
+        tracker.setDbusDemand(false);
+        QTRY_COMPARE(spy.count(), 2);
+        QCOMPARE(spy.last().at(0).toBool(), false);
+    }
+
+    void noDemandWhileInactiveDoesNothing()
+    {
+        DemandTracker tracker;
+        tracker.setStopDelay(50);
+        QSignalSpy spy(&tracker, &DemandTracker::enableRequested);
+        tracker.setClientCount(0);
+        QTest::qWait(100);
+        QCOMPARE(spy.count(), 0);
+        QVERIFY(!tracker.isActive());
+    }
+
+    void repeatedZeroKeepsOnePendingStop()
+    {
+        DemandTracker tracker;
+        tracker.setStopDelay(50);
+        QSignalSpy spy(&tracker, &DemandTracker::enableRequested);
+        tracker.setClientCount(1);
+        tracker.setClientCount(0);
+        tracker.setClientCount(0); // timer already running
+        QTRY_COMPARE(spy.count(), 2);
+        QTest::qWait(100);
+        QCOMPARE(spy.count(), 2);
+    }
+
+    void activeChangedFollowsTheState()
+    {
+        DemandTracker tracker;
+        tracker.setStopDelay(0);
+        QSignalSpy spy(&tracker, SIGNAL(activeChanged(bool)));
+        QVERIFY(spy.isValid());
+
+        tracker.setClientCount(1);
+        QCOMPARE(spy.count(), 1);
+        QCOMPARE(spy.last().at(0).toBool(), true);
+        tracker.setDbusDemand(true); // still active: no change
+        tracker.setClientCount(0);
+        tracker.setDbusDemand(false);
+        QTRY_COMPARE(spy.count(), 2);
+        QCOMPARE(spy.last().at(0).toBool(), false);
+    }
+
+    void resendRepeatsEnableOnlyWhenActive()
+    {
+        DemandTracker tracker;
+        QSignalSpy spy(&tracker, &DemandTracker::enableRequested);
+
+        tracker.resend();
+        QCOMPARE(spy.count(), 0);
+
+        tracker.setClientCount(1);
+        tracker.resend();
+        QCOMPARE(spy.count(), 2);
+        QCOMPARE(spy.last().at(0).toBool(), true);
+    }
+};
+
+QTEST_GUILESS_MAIN(DemandTrackerTest)
+#include "demandtrackertest.moc"
