+
+        resolver.resolve();
+        QTRY_COMPARE_WITH_TIMEOUT(spy.count(), 1, 10000);
+    }
+
+    void noEntriesNoSignal()
+    {
+        FakeLookup lookup;
+        CustomDeviceResolver resolver;
+        resolver.setLookup(lookup.function());
+        QSignalSpy spy(&resolver, &CustomDeviceResolver::addressesResolved);
+
+        resolver.resolve();
+        QTest::qWait(50);
+
+        QCOMPARE(spy.count(), 0);
+        QVERIFY(lookup.asked.isEmpty());
+    }
+
+    void defaultLookupUsesTheSystemResolver()
+    {
+        if (const char *missing = missingLocalhostIPv4()) {
+            QSKIP(missing);
+        }
+        CustomDeviceResolver resolver;
+        resolver.setEntries({QStringLiteral("localhost")});
+        QSignalSpy spy(&resolver, &CustomDeviceResolver::addressesResolved);
+
+        resolver.resolve();
+
+        QTRY_COMPARE_WITH_TIMEOUT(spy.count(), 1, 10000);
+        const QList<QHostAddress> addresses = addressesOf(spy, 0);
+        QVERIFY(!addresses.isEmpty());
+        for (const QHostAddress &address : addresses) {
+            QVERIFY2(address.protocol() == QAbstractSocket::IPv4Protocol && address.isLoopback(), qPrintable(address.toString()));
+        }
+    }
+};
+
+QTEST_GUILESS_MAIN(CustomDeviceResolverTest)
