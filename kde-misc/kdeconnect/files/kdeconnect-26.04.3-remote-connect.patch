+#include <netinet/in.h>
+#include <netinet/tcp.h>
+#include <sys/socket.h>
+#endif
+
+// Messages of kdeconnect.core about mDNS, collected by noMdnsInTestMode().
+static QStringList s_mdnsMessages;
+static void collectMdnsMessages(QtMsgType, const QMessageLogContext &context, const QString &message)
+{
+    if (qstrcmp(context.category, "kdeconnect.core") == 0 && message.contains(QLatin1String("mDNS"))) {
+        s_mdnsMessages.append(message);
+    }
+}
+
+// LanLinkProvider sends discovery packets from every non-loopback IPv4 address.
+static bool hasNonLoopbackIPv4Address()
+{
+    const auto interfaces = QNetworkInterface::allInterfaces();
+    for (const QNetworkInterface &iface : interfaces) {
+        if ((iface.flags() & QNetworkInterface::IsUp) && (iface.flags() & QNetworkInterface::IsRunning)) {
+            const auto entries = iface.addressEntries();
+            for (const QNetworkAddressEntry &entry : entries) {
+                if (entry.ip().protocol() == QAbstractSocket::IPv4Protocol && !entry.ip().isLoopback()) {
+                    return true;
+                }
+            }
+        }
+    }
+    return false;
+}
+
+class LanLinkProviderTest : public QObject
+{
+    Q_OBJECT
+
+private:
+    // The "phone": a UDP socket on another loopback address than the provider's 127.0.0.1.
+    const QHostAddress m_phone{QStringLiteral("127.0.0.2")};
+    QUdpSocket m_receiver;
+
+    int m_received = 0;
+
+    // Our own discovery packets that reached m_phone since resetReceived().
+    // (QTRY_VERIFY evaluates its expression once more after it became true.)
+    int received()
+    {
+        while (m_receiver.hasPendingDatagrams()) {
+            const QNetworkDatagram datagram = m_receiver.receiveDatagram();
+            NetworkPacket packet;
+            if (NetworkPacket::unserialize(datagram.data(), &packet)
+                && packet.get<QString>(QStringLiteral("deviceId")) == KdeConnectConfig::instance().deviceId()) {
+                ++m_received;
+            }
+        }
+        return m_received;
+    }
+
+    void resetReceived()
+    {
+        received();
+        m_received = 0;
+    }
+
+    // A second "phone" address, to see that a send happened at all.
+    const QHostAddress m_tablet{QStringLiteral("127.0.0.3")};
+    QUdpSocket m_tabletReceiver;
+
+    int tabletReceived()
+    {
+        int count = 0;
+        while (m_tabletReceiver.hasPendingDatagrams()) {
+            m_tabletReceiver.receiveDatagram();
+            ++count;
+        }
+        return count;
+    }
+
+    // Connects to the provider over TCP from m_phone and goes through the
+    // handshake, so the provider holds a LAN link to m_phone. The phone uses
+    // our own identity and certificate (a link to ourselves, but the provider
+    // does not mind). Returns the phone's end, or nullptr on failure.
+    QSslSocket *connectPhone(LanLinkProvider &provider)
+    {
+        QSignalSpy linked(&provider, &LinkProvider::onConnectionReceived);
+        auto *socket = new QSslSocket(this);
+        if (!socket->bind(m_phone)) {
+            return nullptr;
+        }
+        socket->connectToHost(QHostAddress::LocalHost, provider.tcpPort());
+        if (!socket->waitForConnected()) {
+            return nullptr;
+        }
+        DeviceInfo phone = KdeConnectConfig::instance().deviceInfo();
+        NetworkPacket connectionPacket = phone.toIdentityPacket();
+        connectionPacket.set(QStringLiteral("targetDeviceId"), phone.id);
+        connectionPacket.set(QStringLiteral("targetProtocolVersion"), NetworkPacket::s_protocolVersion);
+        socket->write(connectionPacket.serialize());
+
+        QSslConfiguration sslConfig;
+        sslConfig.setLocalCertificate(KdeConnectConfig::instance().certificate());
+        sslConfig.setPrivateKey(KdeConnectConfig::instance().privateKey());
+        sslConfig.setPeerVerifyMode(QSslSocket::QueryPeer);
+        socket->setSslConfiguration(sslConfig);
+        connect(socket, &QSslSocket::encrypted, socket, [socket, phone]() mutable {
+            socket->write(phone.toIdentityPacket().serialize());
+        });
+        socket->startServerEncryption();
+
+        if (!QTest::qWaitFor([&linked] {
+                return linked.count() == 1;
+            })) {
+            return nullptr;
+        }
+        return socket;
+    }
+
+    bool m_receiversBound = false;
+    static constexpr const char *s_noLoopbackAddresses = "needs the loopback addresses 127.0.0.2 and 127.0.0.3 (not there by default on macOS)";
+
+    // Why the phone and tablet cannot be reached here, or nullptr if they can
+    const char *missingNetwork() const
+    {
+        if (!m_receiversBound) {
+            return s_noLoopbackAddresses;
+        }
+        if (!hasNonLoopbackIPv4Address()) {
+            return "needs a network interface with an IPv4 address to send discovery packets from";
+        }
+        return nullptr;
+    }
+
+    // Resolves every host name to m_phone.
+    CustomDeviceResolver::Lookup lookupToPhone()
+    {
+        return [this](const QString &, QObject *context, std::function<void(const QHostInfo &)> done) {
+            static int id = -1000; // see FakeLookup in customdeviceresolvertest
+            QHostInfo info(--id);
+            info.setAddresses({m_phone});
+            QTimer::singleShot(0, context, [info, done] {
+                done(info);
+            });
+            return id;
+        };
+    }
+
+private Q_SLOTS:
+    void initTestCase()
+    {
+        QStandardPaths::setTestModeEnabled(true);
+        m_receiversBound = m_receiver.bind(m_phone, LanLinkProvider::UDP_PORT, QUdpSocket::ShareAddress)
+            && m_tabletReceiver.bind(m_tablet, LanLinkProvider::UDP_PORT, QUdpSocket::ShareAddress);
+    }
+
+    void cleanup()
+    {
+        KdeConnectConfig::instance().setCustomDevices({});
+        resetReceived();
+        tabletReceived();
+    }
+
+    void noMdnsInTestMode()
+    {
+        QLoggingCategory::setFilterRules(QStringLiteral("kdeconnect.core=true"));
+        const QtMessageHandler previousHandler = qInstallMessageHandler(collectMdnsMessages);
+        s_mdnsMessages.clear();
+        {
+            const LanLinkProvider normal(false, true); // disabled: never started
+        }
+        const QStringList normalMessages = s_mdnsMessages;
+        s_mdnsMessages.clear();
+        {
+            const LanLinkProvider testMode(true);
+        }
+        qInstallMessageHandler(previousHandler);
+        QLoggingCategory::setFilterRules(QString());
+
+#if !defined(Q_OS_WIN) && !defined(Q_OS_MAC)
+        QCOMPARE(normalMessages.size(), 1); // "Using Avahi for mDNS discovery" or "Using mdnsh for mDNS discovery"
+#else
+        Q_UNUSED(normalMessages);
+#endif
+        QCOMPARE(s_mdnsMessages, QStringList());
+    }
+
+    void sendsToCustomDeviceHostNames()
+    {
+        if (const char *missing = missingNetwork()) {
+            QSKIP(missing);
+        }
+        KdeConnectConfig::instance().setCustomDevices({QStringLiteral("phone.example.org")});
+        LanLinkProvider provider(true);
+        auto *resolver = provider.findChild<CustomDeviceResolver *>();
+        QVERIFY(resolver);
+        resolver->setLookup(lookupToPhone());
+
+        provider.onStart();
+
+        QTRY_VERIFY(received() > 0);
+        provider.onStop();
+    }
+
+    void retriesWhileStarted()
+    {
+        if (const char *missing = missingNetwork()) {
+            QSKIP(missing);
+        }
+        KdeConnectConfig::instance().setCustomDevices({m_phone.toString()});
+        LanLinkProvider provider(true);
+        auto *retry = provider.findChild<CustomDeviceRetry *>();
+        QVERIFY(retry);
+
+        provider.onStart();
+        QVERIFY(retry->isActive());
+        QTRY_VERIFY(received() > 0);
+
+        resetReceived();
+        Q_EMIT retry->retryDue();
+        QTRY_VERIFY(received() > 0);
+
+        resetReceived();
+        provider.onNetworkChange();
+        QTRY_VERIFY(received() > 0);
+
+        provider.onStop();
+        QVERIFY(!retry->isActive());
+    }
+
+    void connectedCustomDeviceIsNotSentTo()
+    {
+        if (const char *missing = missingNetwork()) {
+            QSKIP(missing);
+        }
+        // the phone by host name, so that it is resolved on its own
+        KdeConnectConfig::instance().setCustomDevices({m_tablet.toString(), QStringLiteral("phone.example.org")});
+        LanLinkProvider provider(true);
+        auto *resolver = provider.findChild<CustomDeviceResolver *>();
+        auto *retry = provider.findChild<CustomDeviceRetry *>();
+        QVERIFY(resolver);
+        QVERIFY(retry);
+        resolver->setLookup(lookupToPhone());
+        provider.onStart();
+        QTRY_VERIFY(received() > 0);
+
+        QSslSocket *phone = connectPhone(provider);
+        QVERIFY(phone);
+        resetReceived();
+        tabletReceived();
+
+        QSignalSpy resolved(resolver, &CustomDeviceResolver::addressesResolved);
+        Q_EMIT retry->retryDue();
+        QTRY_COMPARE(resolved.count(), 2); // the tablet's address, then the phone's
+        QVERIFY(tabletReceived() > 0);
+        QCOMPARE(received(), 0);
+
+        delete phone;
+        provider.onStop();
+    }
+
+    void lostLinkTriggersImmediateRetry()
+    {
+        if (const char *missing = missingNetwork()) {
+            QSKIP(missing);
+        }
+        KdeConnectConfig::instance().setCustomDevices({m_phone.toString()});
+        LanLinkProvider provider(true);
+        provider.onStart();
+        QTRY_VERIFY(received() > 0);
+        QSslSocket *phone = connectPhone(provider);
+        QVERIFY(phone);
+        resetReceived();
+
+        phone->abort(); // the link goes away; the next retry would be a minute later
+
+        QTRY_VERIFY(received() > 0);
+        delete phone;
+        provider.onStop();
+    }
+
+    void connectingDeviceResetsBackoff()
+    {
+        if (!m_receiversBound) {
+            QSKIP(s_noLoopbackAddresses);
+        }
+        using namespace std::chrono_literals;
+        KdeConnectConfig::instance().setCustomDevices({m_tablet.toString()});
+        LanLinkProvider provider(true);
+        auto *retry = provider.findChild<CustomDeviceRetry *>();
+        QVERIFY(retry);
+        retry->setCondition([] {
+            return true;
+        });
+        retry->setInterval(10ms);
+        retry->setMaximumInterval(1h);
+        provider.onStart();
+        // backing off again from 10ms to 1280ms takes more than a second
+        QTRY_VERIFY(retry->interval() >= 1280ms);
+
+        QSslSocket *phone = connectPhone(provider);
+        QVERIFY(phone);
+
+        QVERIFY(retry->interval() < 1280ms);
+        delete phone;
+        provider.onStop();
+    }
+
+    void noSendAfterStop()
+    {
+        if (const char *missing = missingNetwork()) {
+            QSKIP(missing);
+        }
+        KdeConnectConfig::instance().setCustomDevices({QStringLiteral("phone.example.org")});
+        LanLinkProvider provider(true);
+        auto *resolver = provider.findChild<CustomDeviceResolver *>();
+        QVERIFY(resolver);
+        resolver->setLookup(lookupToPhone());
+
+        provider.onStart();
+        provider.onStop(); // before the name is looked up
+        QTest::qWait(100);
+        QCOMPARE(received(), 0);
+
+        // whatever the resolver still has to say
+        Q_EMIT resolver->addressesResolved({m_phone});
+        QCOMPARE(received(), 0);
+
+        provider.onStart();
+        QTRY_VERIFY(received() > 0);
+        resetReceived();
+        provider.disable();
+        Q_EMIT resolver->addressesResolved({m_phone});
+        QCOMPARE(received(), 0);
+    }
+
+    void noRetryWithoutCustomDevices()
+    {
+        LanLinkProvider provider(true);
+        auto *retry = provider.findChild<CustomDeviceRetry *>();
+        QVERIFY(retry);
+
+        provider.onStart();
+
+        QVERIFY(!retry->isActive());
+        provider.onStop();
+    }
+
+    void configureSocketSetsUserTimeout()
+    {
+#ifndef TCP_USER_TIMEOUT
+        QSKIP("TCP_USER_TIMEOUT is not available on this platform");
+#else
+        QTcpServer server;
+        QVERIFY(server.listen(QHostAddress::LocalHost));
+        QSslSocket socket;
+        socket.connectToHost(QHostAddress::LocalHost, server.serverPort());
+        QVERIFY(socket.waitForConnected());
+
+        LanLinkProvider::configureSocket(&socket);
+
+        unsigned int timeout = 0;
+        socklen_t length = sizeof(timeout);
+        QCOMPARE(getsockopt(socket.socketDescriptor(), IPPROTO_TCP, TCP_USER_TIMEOUT, &timeout, &length), 0);
+        QCOMPARE(timeout, 60000u);
+#endif
+    }
+};
+
+QTEST_GUILESS_MAIN(LanLinkProviderTest)
+#include "lanlinkprovidertest.moc"
