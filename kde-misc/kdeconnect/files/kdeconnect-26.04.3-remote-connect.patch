diff --git a/core/backends/lan/customdeviceresolver.cpp b/core/backends/lan/customdeviceresolver.cpp
new file mode 100644
index 000000000..8af642890
--- /dev/null
+++ b/core/backends/lan/customdeviceresolver.cpp
@@ -0,0 +1,95 @@
+/**
+ * SPDX-FileCopyrightText: 2026 Gert Pellin <gert@pellin.be>
+ *
+ * SPDX-License-Identifier: GPL-2.0-only OR GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
+ */
+
+#include "customdeviceresolver.h"
+
+#include "core_debug.h"
+#include "customdevices.h"
+
+CustomDeviceResolver::CustomDeviceResolver(QObject *parent)
+    : QObject(parent)
+    , m_lookup([](const QString &hostName, QObject *context, std::function<void(const QHostInfo &)> done) {
+        return QHostInfo::lookupHost(hostName, context, std::move(done));
+    })
+    , m_lookupContext(std::make_unique<QObject>())
+{
+}
+
+void CustomDeviceResolver::setEntries(const QStringList &entries)
+{
+    m_entries = entries;
+}
+
+void CustomDeviceResolver::setLookup(const Lookup &lookup)
+{
+    m_lookup = lookup;
+}
+
+void CustomDeviceResolver::resolve()
+{
+    QList<QHostAddress> addresses;
+    for (const QString &entry : std::as_const(m_entries)) {
+        if (!CustomDevices::isValid(entry)) {
+            qCWarning(KDECONNECT_CORE) << "Invalid custom device address" << entry;
+            continue;
+        }
+        const QHostAddress address(entry);
+        if (address.isNull()) {
+            m_lookupIds.append(m_lookup(entry, m_lookupContext.get(), [this, entry](const QHostInfo &info) {
+                m_lookupIds.removeOne(info.lookupId());
+                lookedUp(entry, info);
+            }));
+        } else {
+            addresses.append(address);
+        }
+    }
+    if (!addresses.isEmpty()) {
+        Q_EMIT addressesResolved(addresses);
+    }
+}
+
+void CustomDeviceResolver::cancel()
+{
+    for (const int id : std::as_const(m_lookupIds)) {
+        QHostInfo::abortHostLookup(id);
+    }
+    m_lookupIds.clear();
+    // Results that are on their way already go with their context
+    m_lookupContext = std::make_unique<QObject>();
+}
+
+void CustomDeviceResolver::lookedUp(const QString &hostName, const QHostInfo &info)
+{
+    const QList<QHostAddress> resolved = info.addresses();
+    if (info.error() != QHostInfo::NoError || resolved.isEmpty()) {
+        // Retries look the name up again and again: warn only when it stops resolving
+        if (m_unresolved.contains(hostName)) {
+            qCDebug(KDECONNECT_CORE) << "Could not resolve custom device" << hostName << info.errorString();
+        } else {
+            m_unresolved.insert(hostName);
+            qCWarning(KDECONNECT_CORE) << "Could not resolve custom device" << hostName << info.errorString();
+        }
+        return;
+    }
+    m_unresolved.remove(hostName);
+
+    // Discovery packets are sent from IPv4 addresses only
+    QList<QHostAddress> addresses;
+    for (const QHostAddress &address : resolved) {
+        bool isIPv4 = false;
+        const quint32 ipv4 = address.toIPv4Address(&isIPv4); // also for ::ffff:a.b.c.d
+        if (isIPv4) {
+            addresses.append(QHostAddress(ipv4));
+        }
+    }
+    if (addresses.isEmpty()) {
+        qCDebug(KDECONNECT_CORE) << "Custom device" << hostName << "has no IPv4 address";
+        return;
+    }
+    Q_EMIT addressesResolved(addresses);
+}
+
+#include "moc_customdeviceresolver.cpp"
diff --git a/core/backends/lan/customdeviceresolver.h b/core/backends/lan/customdeviceresolver.h
new file mode 100644
index 000000000..6ce0e28f3
--- /dev/null
+++ b/core/backends/lan/customdeviceresolver.h
@@ -0,0 +1,61 @@
+/**
+ * SPDX-FileCopyrightText: 2026 Gert Pellin <gert@pellin.be>
+ *
+ * SPDX-License-Identifier: GPL-2.0-only OR GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
+ */
+
+#pragma once
+
+#include "kdeconnectcore_export.h"
+
+#include <QHostAddress>
+#include <QHostInfo>
+#include <QList>
+#include <QObject>
+#include <QSet>
+#include <QStringList>
+
+#include <functional>
+#include <memory>
+
+// Turns custom device entries (IP addresses or host names) into addresses.
+// Host names are looked up again on every resolve(), asynchronously.
+class KDECONNECTCORE_EXPORT CustomDeviceResolver : public QObject
+{
+    Q_OBJECT
+
+public:
+    // Looks up hostName and calls done with the result, later; done is not
+    // called if context is destroyed first. Returns the id of the lookup,
+    // which is also the lookupId() of the result. The default uses QHostInfo.
+    using Lookup = std::function<int(const QString &hostName, QObject *context, std::function<void(const QHostInfo &)> done)>;
+
+    explicit CustomDeviceResolver(QObject *parent = nullptr);
+
+    void setEntries(const QStringList &entries);
+    void setLookup(const Lookup &lookup);
+
+public Q_SLOTS:
+    // Emits addressesResolved() right away with all IP addresses among the
+    // entries, and once more for each host name that resolves to an IPv4
+    // address (IPv6 addresses are left out, IPv4-mapped ones converted). Host names
+    // that do not resolve and invalid entries are logged and skipped; a host
+    // name that keeps failing gets a warning only the first time.
+    void resolve();
+
+    // Aborts the lookups that are still running: they emit nothing.
+    void cancel();
+
+Q_SIGNALS:
+    void addressesResolved(const QList<QHostAddress> &addresses);
+
+private:
+    void lookedUp(const QString &hostName, const QHostInfo &info);
+
+    QStringList m_entries;
+    Lookup m_lookup;
+    // Context of the running lookups, replaced on cancel()
+    std::unique_ptr<QObject> m_lookupContext;
+    QList<int> m_lookupIds;
+    QSet<QString> m_unresolved;
+};
diff --git a/core/backends/lan/customdeviceretry.cpp b/core/backends/lan/customdeviceretry.cpp
new file mode 100644
index 000000000..b6e55a28e
--- /dev/null
+++ b/core/backends/lan/customdeviceretry.cpp
@@ -0,0 +1,94 @@
+/**
+ * SPDX-FileCopyrightText: 2026 Gert Pellin <gert@pellin.be>
+ *
+ * SPDX-License-Identifier: GPL-2.0-only OR GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
+ */
+
+#include "customdeviceretry.h"
+
+#include "daemon.h"
+
+#include <algorithm>
+
+CustomDeviceRetry::CustomDeviceRetry(QObject *parent)
+    : QObject(parent)
+{
+    m_timer.setInterval(m_firstInterval);
+    connect(&m_timer, &QTimer::timeout, this, [this] {
+        if (m_condition()) {
+            Q_EMIT retryDue();
+            // Retrying did not help so far: wait twice as long for the next one
+            m_timer.setInterval(std::min(m_timer.intervalAsDuration() * 2, m_maximumInterval));
+        }
+    });
+}
+
+void CustomDeviceRetry::setActive(bool active)
+{
+    if (active) {
+        resetInterval();
+        m_timer.start();
+    } else {
+        m_timer.stop();
+    }
+}
+
+bool CustomDeviceRetry::isActive() const
+{
+    return m_timer.isActive();
+}
+
+void CustomDeviceRetry::setInterval(std::chrono::milliseconds interval)
+{
+    m_firstInterval = interval;
+    m_timer.setInterval(interval);
+}
+
+std::chrono::milliseconds CustomDeviceRetry::interval() const
+{
+    return m_timer.intervalAsDuration();
+}
+
+std::chrono::milliseconds CustomDeviceRetry::remainingTime() const
+{
+    return m_timer.remainingTimeAsDuration();
+}
+
+void CustomDeviceRetry::setMaximumInterval(std::chrono::milliseconds interval)
+{
+    m_maximumInterval = interval;
+}
+
+std::chrono::milliseconds CustomDeviceRetry::maximumInterval() const
+{
+    return m_maximumInterval;
+}
+
+void CustomDeviceRetry::resetInterval()
+{
+    m_timer.setInterval(m_firstInterval);
+}
+
+void CustomDeviceRetry::retryNow()
+{
+    if (m_timer.isActive()) {
+        setActive(true);
+        Q_EMIT retryDue();
+    }
+}
+
+void CustomDeviceRetry::setCondition(const Condition &condition)
+{
+    m_condition = condition;
+}
+
+bool CustomDeviceRetry::pairedDeviceUnreachable()
+{
+    if (!Daemon::hasInstance()) {
+        return false;
+    }
+    const Daemon *daemon = Daemon::instance();
+    return daemon->devices(false, true).size() > daemon->devices(true, true).size();
+}
+
+#include "moc_customdeviceretry.cpp"
diff --git a/core/backends/lan/customdeviceretry.h b/core/backends/lan/customdeviceretry.h
new file mode 100644
index 000000000..856279ee5
--- /dev/null
+++ b/core/backends/lan/customdeviceretry.h
@@ -0,0 +1,68 @@
+/**
+ * SPDX-FileCopyrightText: 2026 Gert Pellin <gert@pellin.be>
+ *
+ * SPDX-License-Identifier: GPL-2.0-only OR GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
+ */
+
+#pragma once
+
+#include "kdeconnectcore_export.h"
+
+#include <QObject>
+#include <QTimer>
+
+#include <chrono>
+#include <functional>
+
+// While active, checks every interval() whether a retry is needed and then
+// emits retryDue(). Used to send the discovery packet to the custom devices
+// again while a paired device is unreachable, e.g. after the other device
+// switched networks. After each retry the interval doubles, up to
+// maximumInterval(); it starts again with the first interval on
+// setActive(true), resetInterval() and retryNow().
+class KDECONNECTCORE_EXPORT CustomDeviceRetry : public QObject
+{
+    Q_OBJECT
+
+public:
+    static constexpr std::chrono::milliseconds DefaultInterval = std::chrono::seconds(60);
+    static constexpr std::chrono::milliseconds DefaultMaximumInterval = std::chrono::minutes(15);
+    using Condition = std::function<bool()>;
+
+    explicit CustomDeviceRetry(QObject *parent = nullptr);
+
+    // (Re)starts with the first interval when active, stops otherwise.
+    void setActive(bool active);
+    bool isActive() const;
+
+    // The first interval; interval() is the current one.
+    void setInterval(std::chrono::milliseconds interval);
+    std::chrono::milliseconds interval() const;
+    std::chrono::milliseconds remainingTime() const;
+
+    void setMaximumInterval(std::chrono::milliseconds interval);
+    std::chrono::milliseconds maximumInterval() const;
+
+    // Goes back to the first interval, without starting or stopping.
+    void resetInterval();
+
+    // When active: emits retryDue() right away, whatever the condition says,
+    // and starts again with the first interval. Does nothing otherwise.
+    void retryNow();
+
+    // The default condition is pairedDeviceUnreachable().
+    void setCondition(const Condition &condition);
+
+    // True if at least one paired device known to the daemon is not reachable.
+    // False if there is no daemon.
+    static bool pairedDeviceUnreachable();
+
+Q_SIGNALS:
+    void retryDue();
+
+private:
+    QTimer m_timer;
+    std::chrono::milliseconds m_firstInterval = DefaultInterval;
+    std::chrono::milliseconds m_maximumInterval = DefaultMaximumInterval;
+    Condition m_condition = &CustomDeviceRetry::pairedDeviceUnreachable;
+};
diff --git a/core/backends/lan/customdevices.cpp b/core/backends/lan/customdevices.cpp
new file mode 100644
index 000000000..af655c5e4
--- /dev/null
+++ b/core/backends/lan/customdevices.cpp
@@ -0,0 +1,51 @@
+/**
+ * SPDX-FileCopyrightText: 2026 Gert Pellin <gert@pellin.be>
+ *
+ * SPDX-License-Identifier: GPL-2.0-only OR GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
+ */
+
+#include "customdevices.h"
+
+#include "core_debug.h"
+
+#include <QHostAddress>
+#include <QRegularExpression>
+
+namespace
+{
+// RFC 1123 host name: labels of letters, digits and -, not starting or ending with -.
+// The last label is not a number, or "999.1.1.1" would be a host name.
+const QRegularExpression s_hostName(QStringLiteral(
+    "^(?=.{1,253}\\.?$)(?!(?:.*\\.)?[0-9]+\\.?$)[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?(?:\\.[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?)*\\.?$"));
+}
+
+bool CustomDevices::isValid(const QString &entry)
+{
+    if (entry != entry.trimmed()) {
+        return false;
+    }
+    const QHostAddress address(entry);
+    if (!address.isNull()) {
+        // Discovery packets are sent from IPv4 addresses only, so no IPv6.
+        // QHostAddress, like inet_aton(), also reads "192.168.1" (as 192.168.0.1), "3232235777"
+        // or "0x7f.1": take only the dotted decimal form, which means what it seems to
+        return address.protocol() == QAbstractSocket::IPv4Protocol && address.toString() == entry;
+    }
+    return s_hostName.match(entry).hasMatch();
+}
+
+QStringList CustomDevices::sanitized(QStringList entries)
+{
+    for (QString &entry : entries) {
+        entry = entry.trimmed();
+    }
+    entries.removeIf([](const QString &entry) {
+        if (isValid(entry)) {
+            return false;
+        }
+        qCWarning(KDECONNECT_CORE) << "Ignoring invalid custom device address" << entry;
+        return true;
+    });
+    entries.removeDuplicates();
+    return entries;
+}
diff --git a/core/backends/lan/customdevices.h b/core/backends/lan/customdevices.h
