+class CustomDevicesTest : public QObject
+{
+    Q_OBJECT
+
+private Q_SLOTS:
+    void cleanup()
+    {
+        QLoggingCategory::setFilterRules(QString());
+    }
+
+    void isValid_data()
+    {
+        QTest::addColumn<QString>("entry");
+        QTest::addColumn<bool>("valid");
+
+        const QString label63(63, QLatin1Char('a'));
+        const QString name253 = label63 + u'.' + label63 + u'.' + label63 + u'.' + QString(61, QLatin1Char('d'));
+        const QString name254 = name253 + u'd';
+
+        QTest::newRow("IPv4") << QStringLiteral("192.168.1.5") << true;
+        QTest::newRow("Tailscale IPv4") << QStringLiteral("100.118.129.75") << true;
+        // discovery packets are sent from IPv4 addresses only
+        QTest::newRow("IPv6") << QStringLiteral("fd7a:115c:a1e0::1") << false;
+        QTest::newRow("IPv6 with scope") << QStringLiteral("fe80::1%wlp2s0") << false;
+        QTest::newRow("IPv4-mapped IPv6") << QStringLiteral("::ffff:192.168.1.5") << false;
+        QTest::newRow("short name") << QStringLiteral("oppo-reno15-5g") << true;
+        QTest::newRow("MagicDNS name") << QStringLiteral("oppo-reno15-5g.tail1234.ts.net") << true;
+        QTest::newRow("final dot") << QStringLiteral("phone.example.org.") << true;
+        QTest::newRow("label of 63") << label63 << true;
+        QTest::newRow("name of 253") << name253 << true;
+        QTest::newRow("empty") << QString() << false;
+        QTest::newRow("space") << QStringLiteral(" ") << false;
+        QTest::newRow("leading space") << QStringLiteral(" 192.168.1.5") << false;
+        QTest::newRow("trailing tab") << QStringLiteral("phone\t") << false;
+        QTest::newRow("inner space") << QStringLiteral("my phone") << false;
+        QTest::newRow("label starts with -") << QStringLiteral("-phone") << false;
+        QTest::newRow("label ends with -") << QStringLiteral("phone-.example") << false;
+        QTest::newRow("empty label") << QStringLiteral("phone..example") << false;
+        QTest::newRow("only a dot") << QStringLiteral(".") << false;
+        QTest::newRow("label of 64") << QString(64, QLatin1Char('a')) << false;
+        QTest::newRow("name of 254") << name254 << false;
+        QTest::newRow("underscore") << QStringLiteral("my_phone") << false;
+        QTest::newRow("brackets") << QStringLiteral("[fd7a:115c:a1e0::1]") << false;
+        QTest::newRow("URL") << QStringLiteral("http://phone") << false;
+        QTest::newRow("port") << QStringLiteral("phone:1716") << false;
+        QTest::newRow("non-ASCII") << QStringLiteral("téléphone") << false;
+        // IPv4 forms that inet_aton() and QHostAddress accept, but mean another address than they seem to
+        QTest::newRow("IPv4 of three parts") << QStringLiteral("192.168.1") << false;
+        QTest::newRow("IPv4 of two parts") << QStringLiteral("1.2") << false;
+        QTest::newRow("IPv4 as one number") << QStringLiteral("3232235777") << false;
+        QTest::newRow("IPv4 in hex") << QStringLiteral("0x7f.1") << false;
+        QTest::newRow("IPv4 with leading zero") << QStringLiteral("192.168.01.5") << false;
+        QTest::newRow("IPv4 with final dot") << QStringLiteral("192.168.1.5.") << false;
+        // a host name cannot end in a number: these are broken IPv4 addresses
+        QTest::newRow("IPv4 out of range") << QStringLiteral("999.1.1.1") << false;
+        QTest::newRow("IPv4 of five parts") << QStringLiteral("1.2.3.4.5") << false;
+        QTest::newRow("name ending in a number") << QStringLiteral("phone.example.123") << false;
+        QTest::newRow("name with digits in the last label") << QStringLiteral("phone.example.1a") << true;
+        QTest::newRow("name starting with digits") << QStringLiteral("1.2.3.example") << true;
+    }
+
+    void isValid()
+    {
+        QFETCH(QString, entry);
+        QFETCH(bool, valid);
+        QCOMPARE(CustomDevices::isValid(entry), valid);
+    }
+
+    void sanitized_data()
+    {
+        QTest::addColumn<bool>("logging");
+        QTest::newRow("warnings shown") << true;
+        QTest::newRow("warnings hidden") << false;
+    }
+
+    void sanitized()
+    {
+        QFETCH(bool, logging);
+        QLoggingCategory::setFilterRules(QStringLiteral("kdeconnect.core.warning=%1").arg(logging ? QStringLiteral("true") : QStringLiteral("false")));
+        if (logging) {
+            QTest::ignoreMessage(QtWarningMsg, "Ignoring invalid custom device address \"my phone\"");
+            QTest::ignoreMessage(QtWarningMsg, "Ignoring invalid custom device address \"\"");
+        }
+
+        const QStringList entries{QStringLiteral(" 192.168.1.5 "),
+                                  QStringLiteral("my phone"),
+                                  QString(),
+                                  QStringLiteral("oppo-reno15-5g"),
+                                  QStringLiteral("192.168.1.5"),
+                                  QStringLiteral("\toppo-reno15-5g")};
+        const QStringList expected{QStringLiteral("192.168.1.5"), QStringLiteral("oppo-reno15-5g")};
+        QCOMPARE(CustomDevices::sanitized(entries), expected);
+    }
+
+    void sanitizedEmpty()
+    {
+        QCOMPARE(CustomDevices::sanitized({}), QStringList());
+    }
+};
+
+QTEST_GUILESS_MAIN(CustomDevicesTest)
+#include "customdevicestest.moc"
