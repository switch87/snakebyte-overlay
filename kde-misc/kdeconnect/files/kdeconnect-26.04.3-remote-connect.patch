+    // The tests with the system resolver look up "localhost". The resolver
+    // passes on IPv4 addresses only (127.0.0.1 here), and nothing for ::1.
+    static const char *missingLocalhostIPv4()
+    {
+        const QList<QHostAddress> addresses = QHostInfo::fromName(QStringLiteral("localhost")).addresses();
+        const bool hasIPv4 = std::any_of(addresses.cbegin(), addresses.cend(), [](const QHostAddress &address) {
+            return address.protocol() == QAbstractSocket::IPv4Protocol;
+        });
+        return hasIPv4 ? nullptr : "\"localhost\" has no IPv4 address on this system";
+    }
+
+    void setWarnings(bool shown)
+    {
+        QLoggingCategory::setFilterRules(QStringLiteral("kdeconnect.core.warning=%1").arg(shown ? QStringLiteral("true") : QStringLiteral("false")));
+    }
