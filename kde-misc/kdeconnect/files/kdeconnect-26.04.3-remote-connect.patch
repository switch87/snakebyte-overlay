+// SPDX-FileCopyrightText: 2026 Gert Pellin <gert@pellin.be>
+// SPDX-License-Identifier: GPL-2.0-only OR GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
+
+// Stands in for the D-Bus interface of kdeconnectd. Like the daemon, it drops
+// entries it does not accept (here: anything with whitespace, and IPv6).
+pragma Singleton
+
+import QtQml
+
+QtObject {
+    property list<string> customDevices: []
+    onCustomDevicesChanged: {
+        const valid = customDevices.filter(entry => !/[\s:]/.test(entry));
+        if (valid.length !== customDevices.length) {
+            customDevices = valid;
+        }
+    }
+    function setAnnouncedName(name: string): void {}
+    function setLinkProviderState(name: string, enabled: bool): void {}
+}
