+/**
+ * SPDX-FileCopyrightText: 2026 Gert Pellin <gert@pellin.be>
+ *
+ * SPDX-License-Identifier: GPL-2.0-only OR GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
+ */
+
+#pragma once
+
+#include "kdeconnectcore_export.h"
+
+#include <QStringList>
+
+// Entries of the "custom devices" list: devices that are not found by
+// broadcast or mDNS and get the discovery packet by unicast instead.
+namespace CustomDevices
+{
+// An IPv4 address in dotted decimal form or a host name
+// (RFC 1123: labels of letters, digits and '-', at most 253 characters,
+// optional final '.', the last label not all digits). No whitespace.
+KDECONNECTCORE_EXPORT bool isValid(const QString &entry);
+
+// The entries trimmed, without invalid entries and duplicates, in their order.
+KDECONNECTCORE_EXPORT QStringList sanitized(QStringList entries);
+}
