diff --git a/tests/remoteconnect/customdeviceretrytest.cpp b/tests/remoteconnect/customdeviceretrytest.cpp
new file mode 100644
index 000000000..61462c77e
--- /dev/null
+++ b/tests/remoteconnect/customdeviceretrytest.cpp
@@ -0,0 +1,234 @@
+/**
+ * SPDX-FileCopyrightText: 2026 Gert Pellin <gert@pellin.be>
+ *
+ * SPDX-License-Identifier: GPL-2.0-only OR GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
+ */
+
+#include "testdaemon.h"
+#include "testdevice.h"
+
+#include <backends/lan/customdeviceretry.h>
+#include <kdeconnectconfig.h>
+
+#include <QSignalSpy>
+#include <QStandardPaths>
+#include <QTest>
+
+using namespace std::chrono_literals;
+
+// TestDevice is always reachable; this one is reachable or not as given.
+class RetryTestDevice : public TestDevice
+{
+public:
+    RetryTestDevice(QObject *parent, const QString &id, bool reachable)
+        : TestDevice(parent, id)
+        , m_reachable(reachable)
+    {
+    }
+    bool isReachable() const override
+    {
+        return m_reachable;
+    }
+
+private:
+    bool m_reachable;
+};
+
+class CustomDeviceRetryTest : public QObject
+{
+    Q_OBJECT
+
+private:
+    TestDaemon *m_daemon = nullptr;
+
+private Q_SLOTS:
+    void initTestCase()
+    {
+        QStandardPaths::setTestModeEnabled(true);
+        // devices paired by earlier test runs would be loaded as unreachable
+        const QStringList trusted = KdeConnectConfig::instance().trustedDevices();
+        for (const QString &id : trusted) {
+            KdeConnectConfig::instance().removeTrustedDevice(id);
+        }
+        KdeConnectConfig::instance().setCustomDevices({});
+    }
+
+    // e.g. a LanLinkProvider in a test; the daemon is created further down
+    void noDaemonNoRetry()
+    {
+        QVERIFY(!CustomDeviceRetry::pairedDeviceUnreachable());
+    }
+
+    void defaults()
+    {
+        CustomDeviceRetry retry;
+        QVERIFY(!retry.isActive());
+        QCOMPARE(CustomDeviceRetry::DefaultInterval, 60s);
+        QCOMPARE(retry.interval(), CustomDeviceRetry::DefaultInterval);
+        QCOMPARE(CustomDeviceRetry::DefaultMaximumInterval, 15min);
+        QCOMPARE(retry.maximumInterval(), CustomDeviceRetry::DefaultMaximumInterval);
+    }
+
+    void backsOffWhileRetriesDoNotHelp()
+    {
+        CustomDeviceRetry retry;
+        retry.setInterval(10ms);
+        retry.setMaximumInterval(50ms);
+        retry.setCondition([] {
+            return true;
+        });
+        QList<std::chrono::milliseconds> intervals;
+        connect(&retry, &CustomDeviceRetry::retryDue, this, [&retry, &intervals] {
+            intervals.append(retry.interval());
+        });
+
+        retry.setActive(true);
+
+        QTRY_VERIFY(intervals.size() >= 5);
+        const QList<std::chrono::milliseconds> expected{10ms, 20ms, 40ms, 50ms, 50ms};
+        QCOMPARE(intervals.mid(0, 5), expected);
+    }
+
+    void backoffIsReset()
+    {
+        CustomDeviceRetry retry;
+        retry.setInterval(10ms);
+        retry.setMaximumInterval(1h);
+        retry.setCondition([] {
+            return true;
+        });
+        const auto backOff = [&retry] {
+            return QTest::qWaitFor([&retry] {
+                return retry.interval() >= 40ms;
+            });
+        };
+
+        retry.setActive(true);
+        QVERIFY(backOff());
+        retry.setActive(true); // e.g. network change, other list of custom devices
+        QVERIFY(retry.interval() < 40ms);
+
+        QVERIFY(backOff());
+        retry.resetInterval(); // a device connected
+        QVERIFY(retry.interval() < 40ms);
+        QVERIFY(retry.isActive());
+
+        QVERIFY(backOff());
+        retry.retryNow(); // a device went away
+        QVERIFY(retry.interval() < 40ms);
+
+        retry.setActive(false);
+        retry.resetInterval();
+        QVERIFY(!retry.isActive());
+        QCOMPARE(retry.interval(), 10ms);
+    }
+
+    void retriesEveryIntervalWhileConditionHolds()
+    {
+        CustomDeviceRetry retry;
+        retry.setInterval(20ms);
+        retry.setCondition([] {
+            return true;
+        });
+        QSignalSpy spy(&retry, &CustomDeviceRetry::retryDue);
+
+        retry.setActive(true);
+
+        QVERIFY(retry.isActive());
+        QCOMPARE(spy.count(), 0); // not right away
+        QTRY_VERIFY(spy.count() >= 2);
+    }
+
+    void silentWhileConditionFails()
+    {
+        CustomDeviceRetry retry;
+        retry.setInterval(20ms);
+        int checks = 0;
+        retry.setCondition([&checks] {
+            ++checks;
+            return false;
+        });
+        QSignalSpy spy(&retry, &CustomDeviceRetry::retryDue);
+
+        retry.setActive(true);
+
+        QTRY_VERIFY(checks >= 2);
+        QCOMPARE(spy.count(), 0);
+        QCOMPARE(retry.interval(), 20ms); // nothing to back off from
+    }
+
+    void stopsWhenInactive()
+    {
+        CustomDeviceRetry retry;
+        retry.setInterval(20ms);
+        int checks = 0;
+        retry.setCondition([&checks] {
+            ++checks;
+            return true;
+        });
+        QSignalSpy spy(&retry, &CustomDeviceRetry::retryDue);
+
+        retry.setActive(true);
+        retry.setActive(false);
+
+        QVERIFY(!retry.isActive());
+        QTest::qWait(100);
+        QCOMPARE(checks, 0);
+        QCOMPARE(spy.count(), 0);
+    }
+
+    void retryNowWhileActive()
+    {
+        CustomDeviceRetry retry;
+        retry.setInterval(200ms);
+        retry.setCondition([] {
+            return false; // retryNow() does not ask
+        });
+        QSignalSpy spy(&retry, &CustomDeviceRetry::retryDue);
+        retry.setActive(true);
+        QTest::qWait(150);
+
+        retry.retryNow();
+
+        QCOMPARE(spy.count(), 1); // right away
+        QVERIFY(retry.isActive());
+        QVERIFY(retry.remainingTime() > 150ms); // the interval starts again
+    }
+
+    void retryNowWhileInactive()
+    {
+        CustomDeviceRetry retry;
+        QSignalSpy spy(&retry, &CustomDeviceRetry::retryDue);
+
+        retry.retryNow();
+
+        QCOMPARE(spy.count(), 0);
+        QVERIFY(!retry.isActive());
+    }
+
+    void pairedDeviceUnreachable()
+    {
+        m_daemon = new TestDaemon(this);
+        QVERIFY(!CustomDeviceRetry::pairedDeviceUnreachable()); // only the unpaired loopback device
+
+        m_daemon->addDevice(new RetryTestDevice(this, QStringLiteral("retrytest_reachable"), true));
+        QVERIFY(!CustomDeviceRetry::pairedDeviceUnreachable());
+
+        auto *away = new RetryTestDevice(this, QStringLiteral("retrytest_away"), false);
+        m_daemon->addDevice(away);
+        QVERIFY(CustomDeviceRetry::pairedDeviceUnreachable());
+
+        // the default condition drives the retries
+        CustomDeviceRetry retry;
+        retry.setInterval(20ms);
+        QSignalSpy spy(&retry, &CustomDeviceRetry::retryDue);
+        retry.setActive(true);
+        QTRY_VERIFY(spy.count() >= 1);
+
+        away->unpair(); // not paired and not reachable: the daemon forgets it
+        QVERIFY(!CustomDeviceRetry::pairedDeviceUnreachable());
+    }
+};
+
+QTEST_MAIN(CustomDeviceRetryTest)
+#include "customdeviceretrytest.moc"
