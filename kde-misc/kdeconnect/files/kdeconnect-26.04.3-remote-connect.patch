+// SPDX-FileCopyrightText: 2026 Gert Pellin <gert@pellin.be>
+// SPDX-License-Identifier: GPL-2.0-only OR GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
+
+import QtQuick
+import QtTest
+import org.kde.kdeconnect
+
+TestCase {
+    id: testCase
+    name: "CustomDevicesSettings"
+    width: 800
+    height: 1000
+    when: windowShown
+
+    function createPage() {
+        const component = Qt.createComponent(settingsPageUrl);
+        compare(component.status, Component.Ready, component.errorString());
+        const page = createTemporaryObject(component, testCase, {width: testCase.width, height: testCase.height});
+        verify(page !== null);
+        verify(findChild(page, "customDevicesRepeater") !== null, "no list of custom devices");
+        verify(findChild(page, "customDeviceField") !== null, "no field for a new custom device");
+        return page;
+    }
+
+    function devices() {
+        return Array.from(DaemonDbusInterface.customDevices);
+    }
+
+    function init() {
+        DaemonDbusInterface.customDevices = ["192.168.1.5"];
+    }
+
+    function test_listsCustomDevices() {
+        const repeater = findChild(createPage(), "customDevicesRepeater");
+        compare(repeater.count, 1);
+        compare(repeater.itemAt(0).text, "192.168.1.5");
+    }
+
+    function test_addsTrimmedEntry() {
+        const page = createPage();
+        const field = findChild(page, "customDeviceField");
+        field.text = "  phone.example.org ";
+        page.addCustomDevice();
+        compare(devices(), ["192.168.1.5", "phone.example.org"]);
+        compare(field.text, "");
+        compare(field.statusMessage, "");
+        compare(findChild(page, "customDevicesRepeater").count, 2);
+    }
+
+    function test_existingEntryIsNotAddedTwice() {
+        const page = createPage();
+        const field = findChild(page, "customDeviceField");
+        field.text = "192.168.1.5";
+        page.addCustomDevice();
+        compare(devices(), ["192.168.1.5"]);
+        compare(field.text, "");
+    }
+
+    function test_emptyEntryIsIgnored() {
+        const page = createPage();
+        const field = findChild(page, "customDeviceField");
+        field.text = "   ";
+        page.addCustomDevice();
+        compare(devices(), ["192.168.1.5"]);
+        compare(field.statusMessage, "");
+    }
+
+    function test_rejectedEntryShowsError_data() {
+        return [
+            {tag: "invalid", address: "my phone", message: "\"my phone\" is not a valid IP address or host name."},
+            {tag: "IPv6", address: "fd7a:115c:a1e0::1", message: "Only IPv4 addresses and host names are supported."},
+        ];
+    }
+
+    function test_rejectedEntryShowsError(data) {
+        const page = createPage();
+        const field = findChild(page, "customDeviceField");
+        field.text = data.address;
+        page.addCustomDevice();
+        compare(devices(), ["192.168.1.5"]);
+        compare(field.text, data.address);
+        compare(field.statusMessage, data.message);
+    }
+
+    function test_errorGoesAwayWhenEditing() {
+        const page = createPage();
+        const field = findChild(page, "customDeviceField");
+        field.text = "my phone";
+        page.addCustomDevice();
+        verify(field.statusMessage.length > 0);
+        field.text = "my-phone";
+        compare(field.statusMessage, "");
+    }
+
+    // host names are case-insensitive, and "phone.example.org." is "phone.example.org"
+    function test_hostNameIsNormalized() {
+        const page = createPage();
+        const field = findChild(page, "customDeviceField");
+        field.text = " Phone.Example.ORG. ";
+        page.addCustomDevice();
+        compare(devices(), ["192.168.1.5", "phone.example.org"]);
+        compare(field.text, "");
+    }
+
+    function test_sameHostNameIsNotAddedTwice() {
+        DaemonDbusInterface.customDevices = ["Phone.example.org"]; // stored by an older version
+        const page = createPage();
+        const field = findChild(page, "customDeviceField");
+        field.text = "PHONE.example.org.";
+        page.addCustomDevice();
+        compare(devices(), ["Phone.example.org"]);
+        compare(field.text, "");
+        compare(field.statusMessage, "");
+    }
+
+    function test_removesEntry() {
+        const page = createPage();
+        page.removeCustomDevice("192.168.1.5");
+        compare(devices(), []);
+        compare(findChild(page, "customDevicesRepeater").count, 0);
+    }
+}
