+// Answers lookups from a table, from the event loop, like QHostInfo does.
+class FakeLookup
+{
+public:
+    QHash<QString, QHostInfo> results;
+    QStringList asked;
+    int answered = 0;
+
+    CustomDeviceResolver::Lookup function()
+    {
+        return [this](const QString &hostName, QObject *context, std::function<void(const QHostInfo &)> done) {
+            asked.append(hostName);
+            QHostInfo info = results.value(hostName);
+            // ids of QHostInfo count up from 1: do not abort a real lookup by accident
+            const int id = -1000 - int(asked.size());
+            info.setLookupId(id);
+            QTimer::singleShot(0, context, [this, info, done] {
+                ++answered;
+                done(info);
+            });
+            return id;
+        };
+    }
+
+    static QHostInfo found(const QList<QHostAddress> &addresses)
+    {
+        QHostInfo info;
+        info.setAddresses(addresses);
+        return info;
+    }
+
+    static QHostInfo notFound()
+    {
+        QHostInfo info;
+        info.setError(QHostInfo::HostNotFound);
+        info.setErrorString(QStringLiteral("Host not found"));
+        return info;
+    }
+};
+
+static QList<QHostAddress> addressesOf(const QSignalSpy &spy, int index)
+{
+    return spy.at(index).at(0).value<QList<QHostAddress>>();
+}
+
+class CustomDeviceResolverTest : public QObject
+{
