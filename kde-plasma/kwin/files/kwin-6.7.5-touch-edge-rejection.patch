+++ b/src/backends/libinput/touchedgefilter.h
@@ -0,0 +1,70 @@
+/*
+    KWin - the KDE window manager
+    This file is part of the KDE project.
+
+    SPDX-FileCopyrightText: 2026 Gert Pellin <gert@pellin.be>
+
+    SPDX-License-Identifier: GPL-2.0-or-later
+*/
+#pragma once
+
+#include "kwin_export.h"
+
+#include <QSizeF>
+
+#include <deque>
+#include <map>
+#include <memory>
+
+namespace KWin
+{
+namespace LibInput
+{
+
+class Event;
+class TouchEvent;
+
+/**
+ * Holds back touches that start close to the edge of a touch screen, against
+ * ghost touches from holding the device or from dirt along the edges.
+ *
+ * A touch whose down position is less than the edge rejection width away from
+ * an edge of the device is held back. When it moves more than MoveThreshold
+ * away from where it started, it is released: its own down event (original
+ * time and position) and the motion that released it are delivered, so edge
+ * swipes keep working. When it ends or is cancelled while held back, it is
+ * dropped. A frame is only delivered when an event was delivered since the
+ * previous frame. Every touch point is judged on its own. Positions and sizes
+ * are in mm, as libinput reports them for touch screens.
+ */
+class KWIN_EXPORT TouchEdgeFilter
+{
+public:
+    /// Distance in mm a held-back touch has to move to be released.
+    static constexpr double MoveThreshold = 3.0;
+    /// Largest edge rejection width in mm.
+    static constexpr double MaximumWidth = 10.0;
+
+    TouchEdgeFilter();
+    ~TouchEdgeFilter();
+
+    /**
+     * Appends @p event to @p queue, unless it is a touch event of a known device:
+     * that one goes through the device's filter, see process().
+     */
+    static void enqueue(std::unique_ptr<Event> event, std::deque<std::unique_ptr<Event>> &queue);
+
+    /**
+     * Passes the touch event @p event of a device of @p size mm through the filter,
+     * with an edge rejection width of @p width mm (0 = off), and appends the events
+     * to deliver now to @p queue.
+     */
+    void process(std::unique_ptr<TouchEvent> event, double width, const QSizeF &size, std::deque<std::unique_ptr<Event>> &queue);
+
+private:
+    std::map<qint32, std::unique_ptr<TouchEvent>> m_held;
+    bool m_frameHasEvents = false;
+};
+
+}
+}
