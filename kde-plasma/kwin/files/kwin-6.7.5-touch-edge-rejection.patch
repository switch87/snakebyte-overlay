@@ -0,0 +1,79 @@
+/*
+    KWin - the KDE window manager
+    This file is part of the KDE project.
+
+    SPDX-FileCopyrightText: 2026 Gert Pellin <gert@pellin.be>
+
+    SPDX-License-Identifier: GPL-2.0-or-later
+*/
+#include "touchedgefilter.h"
+#include "device.h"
+#include "events.h"
+
+#include <cmath>
+
+namespace KWin
+{
+namespace LibInput
+{
+
+TouchEdgeFilter::TouchEdgeFilter() = default;
+
+TouchEdgeFilter::~TouchEdgeFilter() = default;
+
+void TouchEdgeFilter::enqueue(std::unique_ptr<Event> event, std::deque<std::unique_ptr<Event>> &queue)
+{
+    const libinput_event_type type = event->type();
+    const bool touch = type >= LIBINPUT_EVENT_TOUCH_DOWN && type <= LIBINPUT_EVENT_TOUCH_FRAME;
+    Device *device = touch ? event->device() : nullptr;
+    if (!device) {
+        queue.push_back(std::move(event));
+        return;
+    }
+    std::unique_ptr<TouchEvent> touchEvent(static_cast<TouchEvent *>(event.release()));
+    device->touchEdgeFilter()->process(std::move(touchEvent), device->touchEdgeRejectionWidth(), device->size(), queue);
+}
+
+void TouchEdgeFilter::process(std::unique_ptr<TouchEvent> event, double width, const QSizeF &size, std::deque<std::unique_ptr<Event>> &queue)
+{
+    switch (event->type()) {
+    case LIBINPUT_EVENT_TOUCH_FRAME:
+        if (m_frameHasEvents) {
+            m_frameHasEvents = false;
+            queue.push_back(std::move(event));
+        }
+        return;
+    case LIBINPUT_EVENT_TOUCH_DOWN: {
+        const QPointF position = event->absolutePos();
+        if (width > 0
+            && (position.x() < width || position.y() < width || size.width() - position.x() < width || size.height() - position.y() < width)) {
+            const qint32 id = event->id();
+            m_held[id] = std::move(event);
+            return;
+        }
+        break;
+    }
+    case LIBINPUT_EVENT_TOUCH_MOTION: {
+        const auto held = m_held.find(event->id());
+        if (held != m_held.end()) {
+            const QPointF moved = event->absolutePos() - held->second->absolutePos();
+            if (std::hypot(moved.x(), moved.y()) <= MoveThreshold) {
+                return;
+            }
+            queue.push_back(std::move(held->second));
+            m_held.erase(held);
+        }
+        break;
+    }
+    default: // up and cancel
+        if (m_held.erase(event->id())) {
+            return;
+        }
+        break;
+    }
+    m_frameHasEvents = true;
+    queue.push_back(std::move(event));
+}
+
+}
+}
