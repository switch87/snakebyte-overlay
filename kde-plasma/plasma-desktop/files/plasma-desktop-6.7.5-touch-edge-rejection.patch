diff --git a/kcms/touchscreen/ui/main.qml b/kcms/touchscreen/ui/main.qml
index 28f99a46..cceb4d3a 100644
--- a/kcms/touchscreen/ui/main.qml
+++ b/kcms/touchscreen/ui/main.qml
@@ -83,5 +83,55 @@ KCMUtils.SimpleKCM {
                 }
             }
         }
+
+        RowLayout {
+            Kirigami.FormData.label: i18nc("@label:spinbox", "Ignore touches starting near the edge:")
+            enabled: root.device?.supportsTouchEdgeRejection ?? false
+            spacing: Kirigami.Units.smallSpacing
+
+            QQC2.SpinBox {
+                id: edgeRejectionSpinBox
+                // in half millimetres: 0 to 10 mm in steps of 0.5 mm
+                from: 0
+                to: 20
+                value: Math.round((root.device?.touchEdgeRejectionWidth ?? 0) * 2)
+                textFromValue: (value, locale) => value === 0
+                    ? i18nc("@item:inrange edge rejection is off", "Off")
+                    : i18nc("@item:inrange distance from the screen edge in millimetres", "%1 mm", Number(value / 2).toLocaleString(locale, 'f', 1))
+                onValueModified: root.device.touchEdgeRejectionWidth = value / 2
+            }
+
+            QQC2.Label {
+                // The band on the screen in logical pixels: the touch screen's longer
+                // side spans the longer side of the screen it is mapped to.
+                readonly property int pixels: {
+                    const device = root.device;
+                    if (!device || edgeRejectionSpinBox.value === 0 || device.size.width <= 0 || device.size.height <= 0) {
+                        return 0;
+                    }
+                    const screens = Application.screens;
+                    let screen = null;
+                    for (let i = 0; i < screens.length; ++i) {
+                        if (screens[i].name === device.outputName) {
+                            screen = screens[i];
+                        }
+                    }
+                    if (!screen && device.outputName === "" && screens.length === 1) {
+                        screen = screens[0];
+                    }
+                    if (!screen) {
+                        return 0;
+                    }
+                    const pixelsPerMillimetre = Math.max(screen.width, screen.height) / Math.max(device.size.width, device.size.height);
+                    return Math.round(edgeRejectionSpinBox.value / 2 * pixelsPerMillimetre);
+                }
+                visible: pixels > 0
+                text: i18nc("@info approximate width on the screen", "≈ %1 px", pixels)
+            }
+
+            Kirigami.ContextualHelpButton {
+                toolTipText: i18nc("@info:tooltip", "Touches that start this close to an edge of the screen are ignored unless they move, so holding the screen at its edge or a dirty edge does not cause taps. Swipes from the edge still work; taps that close to the edge do not.")
+            }
+        }
     }
 }
