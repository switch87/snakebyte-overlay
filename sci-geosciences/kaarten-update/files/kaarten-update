#!/usr/bin/env python3
"""kaarten-update: houd Garmin-kaarten (.img) bij in QMapShack en op aangesloten Garmin-toestellen.

Universeel: welke kaarten, waarvandaan en waarheen staat in een TOML-bestand
(standaard ~/.config/kaarten-update.toml; wordt bij de eerste start aangemaakt
met een voorbeeld). Elke kaart is een download (.zip met een .img erin, of een
losse .img) van een HTTP(S)-server.

Gebruik:
    kaarten-update                  nieuwe versies downloaden en installeren
    kaarten-update --check          enkel tonen welke kaarten nieuw zijn
    kaarten-update --force          alles opnieuw installeren
    kaarten-update --kaart NAAM     enkel deze kaart(en) (meermaals te geven)
    kaarten-update --geen-garmin    Garmin-toestellen overslaan
    kaarten-update --config PAD     ander configuratiebestand

Werking:
- Nieuw = de ETag/Last-Modified van de server verschilt van de vorige keer;
  anders wordt er niets gedownload.
- Downloads worden hervat na een onderbreking en zip-bestanden gecontroleerd.
- Garmin-toestellen worden herkend aan Garmin/GarminDevice.xml op een
  gekoppelde schijf (met het opgegeven label; niet-gekoppelde worden via
  udisksctl gekoppeld). Bestanden worden eerst als .part geschreven en pas
  daarna hernoemd, zodat een uitgetrokken kabel geen half bestand achterlaat.
  Andere bestanden op het toestel blijven ongemoeid.
"""
import argparse
import fnmatch
import json
import os
import shutil
import subprocess
import sys
import time
import tomllib
import urllib.parse
import urllib.request
import zipfile
from pathlib import Path

HOME = Path.home()
STANDAARD_CONFIG = HOME / ".config/kaarten-update.toml"
STATUS = HOME / ".local/state/kaarten-update.json"
CACHE = HOME / ".cache/kaarten-update"

VOORBEELD = '''\
# kaarten-update: welke Garmin-kaarten (.img) bijgehouden worden.
# Elke [[kaart]] is een download: een .zip met een .img erin, of een losse .img.

[algemeen]
# Map(pen) van QMapShack waar de .img-kaarten komen (leeg = QMapShack overslaan).
qmapshack_maps = "~/QMapShackData/Maps"
# Schijflabel(s) van Garmin-toestellen (een Edge/eTrex/Fenix in USB-schijfmodus heet "GARMIN").
garmin_labels = ["GARMIN"]

[[kaart]]
naam = "OpenFietsMap Benelux"
# Download-URL (.zip of .img)
url = "https://ligfietser.dev.openstreetmap.org/openfietsmap/benelux/full/OpenFietsMap.zip"
# Welk bestand in de zip (glob-patroon); niet nodig bij een losse .img
bestand_in_zip = "*gmapsupp.img"
# Bestandsnaam in QMapShack (leeg = niet in QMapShack)
qmapshack_naam = "OpenFietsMap_Benelux.img"
# Bestandsnaam in de map Garmin/ op het toestel (leeg = niet op Garmin)
garmin_naam = "gmapsupp-openfietsmap.img"

# Nog een kaart toevoegen? Kopieer het blok hierboven, bijvoorbeeld:
# [[kaart]]
# naam = "OpenFietsMap Benelux light"
# url = "https://ligfietser.dev.openstreetmap.org/openfietsmap/benelux/light/OpenFietsMap_light.zip"
# bestand_in_zip = "*gmapsupp.img"
# qmapshack_naam = ""
# garmin_naam = "gmapsupp-ofm-light.img"
'''


def log(tekst):
    print(f"{time.strftime('%H:%M:%S')} {tekst}", flush=True)


def melding(tekst):
    if shutil.which("notify-send") and (os.environ.get("DISPLAY") or os.environ.get("WAYLAND_DISPLAY")):
        subprocess.run(["notify-send", "-a", "Kaarten", "Kaarten-update", tekst], check=False)


def lees_config(pad):
    if not pad.exists():
        pad.parent.mkdir(parents=True, exist_ok=True)
        pad.write_text(VOORBEELD)
        log(f"voorbeeldconfiguratie aangemaakt: {pad}")
    with open(pad, "rb") as f:
        cfg = tomllib.load(f)
    alg = cfg.get("algemeen", {})
    qms = alg.get("qmapshack_maps", "")
    alg["qmapshack_maps"] = Path(qms).expanduser() if qms else None
    alg["garmin_labels"] = [l.upper() for l in alg.get("garmin_labels", ["GARMIN"])]
    kaarten = cfg.get("kaart", [])
    for k in kaarten:
        for veld in ("naam", "url"):
            if not k.get(veld):
                sys.exit(f"{pad}: een [[kaart]] mist '{veld}'")
    return alg, kaarten


def lees_status():
    try:
        return json.loads(STATUS.read_text())
    except (OSError, ValueError):
        return {}


def bewaar_status(status):
    STATUS.parent.mkdir(parents=True, exist_ok=True)
    STATUS.write_text(json.dumps(status, indent=2, ensure_ascii=False) + "\n")


def cache_naam(kaart):
    return "".join(c if c.isalnum() else "_" for c in kaart["naam"])


def server_versie(url):
    req = urllib.request.Request(url, method="HEAD")
    with urllib.request.urlopen(req, timeout=30) as r:
        h = r.headers
        return {
            "id": h.get("ETag") or h.get("Last-Modified") or h.get("Content-Length", ""),
            "datum": h.get("Last-Modified", "?"),
            "grootte": int(h.get("Content-Length", 0) or 0),
        }


def download(kaart, versie):
    """Download (met hervatten) naar de cache; geeft het pad terug."""
    CACHE.mkdir(parents=True, exist_ok=True)
    naam = Path(urllib.parse.urlparse(kaart["url"]).path).name or "download"
    doel = CACHE / f"{cache_naam(kaart)}--{naam}"
    deel = doel.with_name(doel.name + ".part")
    merk = doel.with_name(doel.name + ".versie")
    zelfde = merk.exists() and merk.read_text() == versie["id"]
    if doel.exists() and zelfde:
        log(f"{kaart['naam']}: download staat al in de cache")
        return doel
    if deel.exists() and not zelfde:  # half bestand van een oudere versie
        deel.unlink()
    merk.write_text(versie["id"])
    begin = deel.stat().st_size if deel.exists() else 0
    req = urllib.request.Request(kaart["url"])
    if begin:
        req.add_header("Range", f"bytes={begin}-")
        log(f"{kaart['naam']}: download hervat vanaf {begin / 1e6:.0f} MB")
    with urllib.request.urlopen(req, timeout=60) as r, open(deel, "ab" if begin else "wb") as f:
        if begin and r.status != 206:  # server negeert Range
            f.seek(0)
            f.truncate()
            begin = 0
        totaal, gelezen, laatst = versie["grootte"], begin, 0.0
        while blok := r.read(1 << 20):
            f.write(blok)
            gelezen += len(blok)
            if time.monotonic() - laatst > 15:
                log(f"{kaart['naam']}: {gelezen / 1e6:.0f}" + (f"/{totaal / 1e6:.0f}" if totaal else "") + " MB")
                laatst = time.monotonic()
    if versie["grootte"] and deel.stat().st_size != versie["grootte"]:
        sys.exit(f"{kaart['naam']}: download onvolledig ({deel.stat().st_size} van {versie['grootte']} bytes)")
    deel.replace(doel)
    return doel


def maak_img(kaart, download_pad):
    """Geeft het pad naar de .img (uit de zip gehaald, of de download zelf)."""
    if not zipfile.is_zipfile(download_pad):
        return download_pad
    patroon = kaart.get("bestand_in_zip", "*.img")
    with zipfile.ZipFile(download_pad) as z:
        fout = z.testzip()
        if fout:
            download_pad.unlink()
            sys.exit(f"{kaart['naam']}: zip beschadigd ({fout}); opnieuw proberen")
        namen = [n for n in z.namelist() if fnmatch.fnmatch(n.lower(), patroon.lower())]
        if len(namen) != 1:
            sys.exit(f"{kaart['naam']}: '{patroon}' past op {len(namen)} bestanden in de zip: {namen[:10]}")
        img = CACHE / f"{cache_naam(kaart)}.img"
        with z.open(namen[0]) as bron, open(img, "wb") as doel:
            shutil.copyfileobj(bron, doel, 1 << 20)
    log(f"{kaart['naam']}: {namen[0]} uitgepakt ({img.stat().st_size / 1e6:.0f} MB)")
    return img


def veilig_kopieer(bron, doel):
    """Kopieer via een .part-bestand en hernoem pas als alles op schijf staat."""
    doel.parent.mkdir(parents=True, exist_ok=True)
    tmp = doel.with_name(doel.name + ".part")
    with open(bron, "rb") as b, open(tmp, "wb") as d:
        shutil.copyfileobj(b, d, 1 << 20)
        d.flush()
        os.fsync(d.fileno())
    tmp.replace(doel)
    subprocess.run(["sync", "-f", str(doel)], check=False)


def garmin_toestellen(labels):
    """Gekoppelde Garmin-toestellen (koppelt ze indien nodig): {naam: map}."""
    gevonden = {}
    try:
        uit = subprocess.run(["lsblk", "-J", "-o", "PATH,LABEL,MOUNTPOINTS"],
                             capture_output=True, text=True, check=True).stdout
    except (OSError, subprocess.CalledProcessError):
        return gevonden

    def alle(devs):
        for d in devs:
            yield d
            yield from alle(d.get("children", []))

    for d in alle(json.loads(uit).get("blockdevices", [])):
        if (d.get("label") or "").upper() not in labels:
            continue
        punten = [p for p in (d.get("mountpoints") or []) if p]
        if not punten and shutil.which("udisksctl"):
            subprocess.run(["udisksctl", "mount", "-b", d["path"]], capture_output=True, text=True)
            uit2 = subprocess.run(["lsblk", "-no", "MOUNTPOINTS", d["path"]], capture_output=True, text=True).stdout
            punten = [p for p in uit2.split("\n") if p]
        for p in punten:
            xml = Path(p) / "Garmin/GarminDevice.xml"
            if xml.exists():
                t = xml.read_text(errors="ignore")
                model = t.split("<Description>", 1)[1].split("<", 1)[0] if "<Description>" in t else "Garmin"
                serie = t.split("<Id>", 1)[1].split("<", 1)[0] if "<Id>" in t else p
                gevonden[f"{model} ({serie})"] = Path(p)
    return gevonden


def main():
    ap = argparse.ArgumentParser(description="Garmin-kaarten bijhouden in QMapShack en op Garmin-toestellen.")
    ap.add_argument("--config", type=Path, default=STANDAARD_CONFIG)
    ap.add_argument("--check", action="store_true", help="enkel tonen wat nieuw is")
    ap.add_argument("--force", action="store_true", help="alles opnieuw installeren")
    ap.add_argument("--kaart", action="append", help="enkel deze kaart (naam uit de configuratie)")
    ap.add_argument("--geen-garmin", action="store_true", help="Garmin-toestellen overslaan")
    args = ap.parse_args()

    alg, kaarten = lees_config(args.config)
    if args.kaart:
        kaarten = [k for k in kaarten if k["naam"] in args.kaart]
        if not kaarten:
            sys.exit(f"geen kaart met die naam in {args.config}")
    status = lees_status()
    toestellen = {} if (args.geen_garmin or args.check) else garmin_toestellen(alg["garmin_labels"])
    if toestellen:
        log("Garmin: " + ", ".join(toestellen))
    gedaan = []

    for kaart in kaarten:
        st = status.setdefault(kaart["naam"], {})
        try:
            versie = server_versie(kaart["url"])
        except OSError as e:
            log(f"{kaart['naam']}: server niet bereikbaar ({e})")
            continue
        nieuw = versie["id"] != st.get("versie")
        log(f"{kaart['naam']}: server {versie['datum']} ({versie['grootte'] / 1e6:.0f} MB)"
            + (" - NIEUW" if nieuw else " - al geïnstalleerd"))
        if args.check:
            continue

        qms_doel = alg["qmapshack_maps"] / kaart["qmapshack_naam"] if alg["qmapshack_maps"] and kaart.get("qmapshack_naam") else None
        doe_qms = qms_doel and (args.force or nieuw or not qms_doel.exists())
        doe_garmin = {}
        if kaart.get("garmin_naam"):
            for tnaam, m in toestellen.items():
                doel = m / "Garmin" / kaart["garmin_naam"]
                if args.force or not doel.exists() or st.get("garmin", {}).get(tnaam) != versie["id"]:
                    doe_garmin[tnaam] = doel
        if not doe_qms and not doe_garmin:
            continue

        zip_of_img = download(kaart, versie)
        img = maak_img(kaart, zip_of_img)
        if doe_qms:
            veilig_kopieer(img, qms_doel)
            log(f"{kaart['naam']}: QMapShack -> {qms_doel}")
        for tnaam, doel in doe_garmin.items():
            vrij = shutil.disk_usage(doel.parent).free + (doel.stat().st_size if doel.exists() else 0)
            if vrij < img.stat().st_size + 50e6:
                log(f"{kaart['naam']}: {tnaam} heeft te weinig ruimte ({vrij / 1e6:.0f} MB), overgeslagen")
                continue
            log(f"{kaart['naam']}: kopiëren naar {tnaam} ({doel}) ...")
            veilig_kopieer(img, doel)
            st.setdefault("garmin", {})[tnaam] = versie["id"]
        st.update(versie=versie["id"], datum=versie["datum"], geinstalleerd=time.strftime("%Y-%m-%d %H:%M"))
        bewaar_status(status)
        if img != zip_of_img:
            img.unlink(missing_ok=True)  # uitgepakte kopie; de download zelf blijft in de cache
        gedaan.append(kaart["naam"] + (f" (+ {', '.join(doe_garmin)})" if doe_garmin else ""))

    if gedaan:
        tekst = "Bijgewerkt: " + "; ".join(gedaan)
        log(tekst)
        melding(tekst + ". In QMapShack: rechtsklik op de kaartlijst -> Reload maps.")
    elif not args.check:
        log("alles is up-to-date")
    return 0


if __name__ == "__main__":
    sys.exit(main())
