--- /dev/null
+++ b/src/qmapshack/gis/trk/surface/CSurfaceAnalyzer.cpp
@@ -0,0 +1,102 @@
+/**********************************************************************************************
+    Copyright (C) 2026 Gert Pellin <gert@pellin.be>
+
