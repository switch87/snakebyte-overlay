 qreal CGisItemTrk::getMax(const QString& source) const {
+  if (CKnownExtension::isCategorical(source)) {
+    return CKnownExtension::get(source).maximum;
+  }
   return extrema.value(source).max * CKnownExtension::get(source).factor;
 }
 
